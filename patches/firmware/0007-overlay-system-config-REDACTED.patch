index 00000000..a73a7f48
--- /dev/null
+++ b/general/overlay/usr/sbin/sysupgrade.sh
@@ -0,0 +1,198 @@
+#!/bin/sh
+# sysupgrade.sh — safe on-device rootfs upgrade
+#
+# Downloads a rootfs image, validates it thoroughly, then spawns a
+# detached flash process that is immune to SSH disconnection.  Works
+# with the safe-mode system in rcS: if the new rootfs doesn't boot
+# properly, the next reboot enters safe mode (WiFi + SSH only) so you
+# can reflash without physical access.
+#
+# Usage:
+#   sysupgrade.sh <url>            Download image from URL and flash
+#   sysupgrade.sh <local_path>     Flash a pre-downloaded image from /tmp
+#   sysupgrade.sh --commit         Mark current rootfs as good (exit safe mode)
+#   sysupgrade.sh --status         Show current boot state
+#
+# The URL can be an HTTP server on your LAN, e.g.:
+#   On host:   python3 -m http.server 9997 --directory flash/
+#   On device: sysupgrade.sh http://192.168.1.2:9997/rootfs.img
+
+set -e
+
+# ── Detect rootfs MTD partition ──────────────────────────────────────────
+# Find the MTD partition named "rootfs" from /proc/mtd rather than
+# hardcoding a partition number that may differ across flash layouts.
+detect_rootfs_mtd() {
+    local mtd_name mtd_num
+    mtd_name=$(grep '"rootfs"' /proc/mtd 2>/dev/null | head -1 | cut -d: -f1)
+    if [ -z "$mtd_name" ]; then
+        # Fallback: look for the squashfs partition by trying the current root
+        # device.  /dev/root -> mtdblock2 is the typical case.
+        mtd_num=$(readlink /dev/root 2>/dev/null | sed 's/mtdblock//')
+        if [ -z "$mtd_num" ]; then
+            mtd_num=2  # final fallback
+        fi
+        mtd_name="mtd${mtd_num}"
+    fi
+    echo "$mtd_name"
+}
+
+MTD_NAME=$(detect_rootfs_mtd)
+MTD_DEV="/dev/${MTD_NAME}"
+MTD_NUM=$(echo "$MTD_NAME" | sed 's/mtd//')
+IMG=/tmp/_upgrade.img
+FLASH_LOG=/tmp/_sysupgrade.log
+
+die() { echo "ERROR: $*" >&2; exit 1; }
+
+# ── Commands ─────────────────────────────────────────────────────────────
+
+case "$1" in
+    --commit)
+        fw_setenv boot_ok 1
+        echo "Boot committed.  Normal boot on next reboot."
+        exit 0
+        ;;
+    --status)
+        BOOT_OK=$(fw_printenv -n boot_ok 2>/dev/null || echo "<unset>")
+        echo "boot_ok = $BOOT_OK"
+        case "$BOOT_OK" in
+            1) echo "Status: normal (last boot succeeded)" ;;
+            0) echo "Status: SAFE MODE armed (upgrade pending or last boot failed)" ;;
+            *) echo "Status: not configured (will boot normally)" ;;
+        esac
+        exit 0
+        ;;
+    --do-flash)
+        # Internal: called by the detached flash process.  Do not run directly.
+        # At this point the image has been validated and safe mode is armed.
+        # stdin/stdout/stderr are redirected to the log file by the caller.
+        IMG="$2"
+        MTD_DEV="$3"
+
+        echo "$(date) Flash starting: $IMG -> $MTD_DEV"
+
+        # Copy flash tools to tmpfs before we erase the squashfs they live on.
+        cp /usr/sbin/flashcp /tmp/_flashcp 2>/dev/null || cp "$(which flashcp)" /tmp/_flashcp
+        cp /usr/sbin/flash_eraseall /tmp/_flash_eraseall 2>/dev/null || cp "$(which flash_eraseall)" /tmp/_flash_eraseall
+        chmod +x /tmp/_flashcp /tmp/_flash_eraseall
+
+        sync
+
+        echo "$(date) Erasing $MTD_DEV..."
+        /tmp/_flash_eraseall "$MTD_DEV"
+
+        echo "$(date) Writing $IMG..."
+        /tmp/_flashcp -v "$IMG" "$MTD_DEV"
+
+        echo "$(date) Flash complete.  Rebooting..."
+        rm -f "$IMG"
+        sync
+        sleep 1
+        reboot -f 2>/dev/null || echo b > /proc/sysrq-trigger
+        exit 0
+        ;;
+    "")
+        echo "Usage: sysupgrade.sh <url_or_path> | --commit | --status"
+        exit 1
+        ;;
+esac
+
+SRC="$1"
+
+echo "=== sysupgrade ==="
+echo "Rootfs partition: $MTD_DEV (${MTD_NAME})"
+
+# ── Step 1: Acquire image ────────────────────────────────────────────────
+
+if echo "$SRC" | grep -q '://'; then
+    echo "[1/5] Downloading image..."
+    rm -f "$IMG"
+    wget -q -O "$IMG" "$SRC" || die "Download failed: $SRC"
+else
+    [ -f "$SRC" ] || die "File not found: $SRC"
+    if [ "$SRC" != "$IMG" ]; then
+        cp "$SRC" "$IMG"
+    fi
+fi
+
+IMG_SIZE=$(stat -c%s "$IMG")
+echo "      Image: $IMG ($((IMG_SIZE / 1024)) KB)"
+
+# ── Step 2: Validate image ──────────────────────────────────────────────
+
+echo "[2/5] Validating image..."
+
+# 2a. Size check: must fit in MTD partition
+MTD_SIZE=$(cat /sys/class/mtd/${MTD_NAME}/size 2>/dev/null || echo 0)
+if [ "$MTD_SIZE" -gt 0 ] && [ "$IMG_SIZE" -gt "$MTD_SIZE" ]; then
+    die "Image ($IMG_SIZE bytes) exceeds $MTD_NAME partition ($MTD_SIZE bytes)"
+fi
+if [ "$MTD_SIZE" -gt 0 ]; then
+    echo "      Partition: $MTD_NAME ($((MTD_SIZE / 1024)) KB), image uses $((IMG_SIZE * 100 / MTD_SIZE))%"
+fi
+
+# 2b. Must not be zero-length
+[ "$IMG_SIZE" -gt 0 ] || die "Image is empty"
+
+# 2c. Squashfs magic check (first 4 bytes: 'hsqs' = 0x68737173 LE)
+MAGIC=$(hexdump -n4 -e '4/1 "%02x"' "$IMG")
+if [ "$MAGIC" != "68737173" ]; then
+    die "Not a squashfs image (magic: $MAGIC, expected: 68737173)"
+fi
+
+# 2d. Try to list squashfs contents — catches truncated/corrupt images
+if command -v unsquashfs >/dev/null 2>&1; then
+    if ! unsquashfs -l "$IMG" >/dev/null 2>&1; then
+        die "Squashfs integrity check failed (image may be truncated or corrupt)"
+    fi
+fi
+
+# 2e. Check that critical files exist in the image
+if command -v unsquashfs >/dev/null 2>&1; then
+    LIST=$(unsquashfs -l "$IMG" 2>/dev/null)
+    for f in /sbin/init /bin/busybox /usr/sbin/dropbear /etc/init.d/rcS; do
+        echo "$LIST" | grep -q "$f" || die "Image missing $f"
+    done
+    echo "      Critical files verified: init, busybox, dropbear, rcS"
+else
+    echo "      WARNING: unsquashfs not available, skipping content check"
+fi
+
+echo "      Validation passed."
+
+# ── Step 3: Arm safe mode ────────────────────────────────────────────────
+
+echo "[3/5] Arming safe mode (boot_ok=0)..."
+fw_setenv boot_ok 0 || die "Failed to set boot_ok — is fw_setenv working?"
+
+# ── Step 4: Launch detached flash process ────────────────────────────────
+#
+# The flash (erase + write) runs in a detached process that survives SSH
+# disconnection.  This is critical: if SSH drops during erase/write, the
+# flash operation continues to completion and reboots the device.
+#
+# The caller (SSH session) can safely disconnect at any point after this
+# step starts.  Progress is logged to /tmp/_sysupgrade.log.
+
+echo "[4/5] Starting flash process (detached, SSH-disconnect safe)..."
+echo "      Progress log: $FLASH_LOG"
+echo "      DO NOT POWER OFF THE DEVICE."
+
+# nohup + redirect + & makes the flash immune to HUP/SSH disconnect.
+# setsid creates a new session so it's fully detached from the terminal.
+nohup setsid sh -c "'$0' --do-flash '$IMG' '$MTD_DEV'" \
+    </dev/null >"$FLASH_LOG" 2>&1 &
+
+echo ""
+echo "[5/5] Flash process launched (PID $!)."
+echo ""
+echo "The device will reboot automatically when flashing completes."
+echo "You may safely disconnect now — the flash will continue."
+echo ""
+echo "After reboot, the first boot enters SAFE MODE (SSH only)."
+echo "Verify the new system, then commit:"
+echo "  sysupgrade.sh --commit && reboot"
+echo ""
+echo "To watch progress (if still connected):"
+echo "  tail -f $FLASH_LOG"
diff --git a/general/overlay/usr/sbin/uart-diag.sh b/general/overlay/usr/sbin/uart-diag.sh
