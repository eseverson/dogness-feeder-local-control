+#!/bin/sh
+# uart-sweep.sh — Brute-force find which UART+pin+mux combo reaches the MCU
+#
+# Watch the logic analyzer TX line while this runs.
+# Each test is announced with a unique marker and a 2-second pause.
+# When you see UART data appear on the LA, note what was printed on console.
+
+IOCFG=0x200f0000
+
+# Save current mux values
+echo "Saving mux state..."
+saved=""
+for off in 0xb8 0xbc 0xc0 0xc4 0xc8 0xcc 0xd0 0xd4; do
+    addr=$(printf '0x%x' $((IOCFG + off)))
+    val=$(devmem "$addr" 32)
+    saved="$saved $off=$val"
+    echo "  $addr = $val"
+done
+
+# Configure both UARTs
+stty -F /dev/ttyAMA1 115200 raw -echo cs8 -cstopb -parenb cread clocal -crtscts 2>/dev/null
+stty -F /dev/ttyAMA2 115200 raw -echo cs8 -cstopb -parenb cread clocal -crtscts 2>/dev/null
+
+# Test pattern - distinct enough to spot on LA
+PATTERN='\xaa\x55\xaa\x55\xaa\x55\xaa\x55'
+
+echo ""
+echo "=== Starting sweep — watch LA for data ==="
+echo "Each combo gets 2 seconds. Note the console output when data appears."
+echo ""
+
+for off in 0xbc 0xc0 0xc4 0xc8 0xcc 0xd0; do
+    for mux in 0 1 2 3 4 5 6 7; do
+        addr=$(printf '0x%x' $((IOCFG + off)))
+
+        # Reset all candidate pins to mux=0 first
+        for r in 0xbc 0xc0 0xc4 0xc8 0xcc 0xd0; do
+            ra=$(printf '0x%x' $((IOCFG + r)))
+            devmem "$ra" 32 0
+        done
+
+        # Set this pin to test mux value
+        devmem "$addr" 32 $mux
+
+        # Send on ttyAMA1
+        echo "TX>> ttyAMA1  pin=$off  mux=$mux"
+        echo -ne "$PATTERN" > /dev/ttyAMA1
+        sleep 1
+
+        # Send on ttyAMA2
+        echo "TX>> ttyAMA2  pin=$off  mux=$mux"
+        echo -ne "$PATTERN" > /dev/ttyAMA2
+        sleep 1
+    done
+done
+
+# Restore
+echo ""
+echo "Restoring mux state..."
+for pair in $saved; do
+    off=$(echo "$pair" | cut -d= -f1)
+    val=$(echo "$pair" | cut -d= -f2)
+    addr=$(printf '0x%x' $((IOCFG + off)))
+    devmem "$addr" 32 "$val"
+done
+
+echo "Sweep complete."
