@@ -0,0 +1,24 @@
+#!/bin/sh
+# Reset U-Boot bootcount to 0 once main has booted far enough to be healthy.
+#
+# U-Boot's boot_with_count env script increments bootcount on every boot and
+# falls through to bootcmdrec once it exceeds bootlimit. This script is the
+# "boot succeeded" signal: if we get here, the kernel + rootfs + init came
+# up successfully, so reset the counter.
+#
+# Runs in the background with a small delay so we don't block init and so
+# the system has a chance to fail (panic, dropbear crash on bad config, etc.)
+# before we declare victory.
+
+case "$1" in
+    start)
+        (
+            sleep 30
+            current=$(fw_printenv -n bootcount 2>/dev/null)
+            if [ "$current" != "0" ]; then
+                fw_setenv bootcount 0
+            fi
+        ) &
+        ;;
+    stop|restart|reload) ;;
+esac
diff --git a/general/overlay/etc/init.d/rcS b/general/overlay/etc/init.d/rcS
index e6456301..7baa50bf 100755
--- a/general/overlay/etc/init.d/rcS
+++ b/general/overlay/etc/init.d/rcS
@@ -3,6 +3,35 @@ export SENSOR=$(fw_printenv -n sensor)
 export UPGRADE=$(fw_printenv -n upgrade)
 export TZ=$(cat /etc/TZ)
 
+# ── Safe-mode check ──────────────────────────────────────────────────────
+# boot_ok is stored in U-Boot env.  Values:
+#   1 = last boot completed (normal boot)
+#   0 = upgrade pending or previous boot failed (safe mode)
+#   <unset> = fresh device, treat as normal
+BOOT_OK=$(fw_printenv -n boot_ok 2>/dev/null)
+
+if [ "$BOOT_OK" = "0" ]; then
+	echo "*** SAFE MODE — previous boot did not complete ***"
+	echo "*** Starting minimal system: modules + network + SSH ***"
+
+	# Run only what's needed for remote access
+	for s in S01syslogd S35modules S36pinmux S38mdev S40network S50dropbear; do
+		i="/etc/init.d/$s"
+		[ -f "$i" ] && $i start
+	done
+
+	echo ""
+	echo "*** SAFE MODE active.  SSH should be available. ***"
+	echo "***   To commit:  fw_setenv boot_ok 1 && reboot  ***"
+	echo "***   To reflash: sysupgrade.sh <url>             ***"
+	exit 0
+fi
+
+# ── Normal boot ──────────────────────────────────────────────────────────
+# Mark boot as not-yet-complete.  If we crash before the end of init,
+# the next reboot enters safe mode.
+fw_setenv boot_ok 0 2>/dev/null
+
 for i in /etc/init.d/S??*; do
 	[ ! -f "$i" ] && continue
 	case "$i" in
@@ -11,3 +40,7 @@ for i in /etc/init.d/S??*; do
 			;;
 	esac
 done
+
+# All init scripts succeeded — mark boot as good.
+fw_setenv boot_ok 1 2>/dev/null
+echo "Boot complete, boot_ok committed."
