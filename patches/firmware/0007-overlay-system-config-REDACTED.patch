@@ -0,0 +1,331 @@
+#!/bin/sh
+# uart-diag.sh — Diagnose and configure UART1 for MCU communication
+# Hi3518EV200 + Dogness STC15W408AS MCU
+#
+# Usage:
+#   uart-diag.sh              — full diagnostic, record all state
+#   uart-diag.sh setup        — set pinmux and configure ttyAMA1
+#   uart-diag.sh listen       — listen for MCU data on ttyAMA1
+#   uart-diag.sh scan         — brute-force scan IOCFG 0xBC-0xD4 for UART1 TX
+
+LOG="/tmp/uart-diag.log"
+UART1_BASE=0x20090000
+CRG_REG=0x200300e4
+IOCFG_BASE=0x200f0000
+
+log() {
+    echo "$@"
+    echo "$@" >> "$LOG"
+}
+
+# ---------------------------------------------------------------
+# Phase 1: Record register state
+# ---------------------------------------------------------------
+record_state() {
+    log "=== UART Diagnostic — $(date) ==="
+    log ""
+
+    log "--- CRG Clock Register (0x200300e4) ---"
+    val=$(devmem $CRG_REG 32)
+    log "  CRG 0xe4 = $val"
+    num=$(printf '%d' "$val")
+    log "  UART0 clk (bit15): $(( (num >> 15) & 1 ))"
+    log "  UART1 clk (bit16): $(( (num >> 16) & 1 ))"
+    log "  UART2 clk (bit17): $(( (num >> 17) & 1 ))"
+    log ""
+
+    log "--- IOCFG Pinmux: UART1/I2S region (0xBC-0xD4) ---"
+    log "  Offset  Value  Pin    Mux=0 function"
+    for info in \
+        "0xbc:47:UART1_CTSN" \
+        "0xc0:48:UART1_RTSN" \
+        "0xc4:49:UART1_RXD" \
+        "0xc8:50:UART1_TXD" \
+        "0xcc:51:NF_DQ1/GPIO" \
+        "0xd0:52:I2S_BCLK/GPIO" \
+        "0xd4:53:JTAG_TRSTN/GPIO"
+    do
+        off=$(echo "$info" | cut -d: -f1)
+        pin=$(echo "$info" | cut -d: -f2)
+        func=$(echo "$info" | cut -d: -f3)
+        addr=$(printf '0x%x' $((IOCFG_BASE + off)))
+        val=$(devmem "$addr" 32)
+        log "  $off    $val   pin$pin  $func"
+    done
+    log ""
+
+    log "--- IOCFG Pinmux: RMII/Ethernet region (0x10-0x3C) ---"
+    log "  (These are NOT UART1 on EV200 despite V100 datasheet)"
+    for off in 0x10 0x14 0x18 0x1c 0x20 0x24 0x28 0x2c 0x34 0x38 0x3c; do
+        addr=$(printf '0x%x' $((IOCFG_BASE + off)))
+        val=$(devmem "$addr" 32)
+        log "  $off = $val"
+    done
+    log ""
+
+    log "--- PL011 UART1 Registers (base 0x20090000) ---"
+    dr=$(devmem 0x20090000 32)
+    fr=$(devmem 0x20090018 32)
+    ibrd=$(devmem 0x20090024 32)
+    fbrd=$(devmem 0x20090028 32)
+    lcr=$(devmem 0x2009002c 32)
+    cr=$(devmem 0x20090030 32)
+    imsc=$(devmem 0x20090038 32)
+    log "  DR   (0x00) = $dr"
+    log "  FR   (0x18) = $fr   (bit4=RXFE, bit5=TXFF, bit7=TXFE)"
+    log "  IBRD (0x24) = $ibrd"
+    log "  FBRD (0x28) = $fbrd"
+    log "  LCR_H(0x2C) = $lcr  (0x60=8N1, 0x70=8N1+FIFO)"
+    log "  CR   (0x30) = $cr   (0x301=UARTEN+TXE+RXE)"
+    log "  IMSC (0x38) = $imsc (interrupt mask: !=0 means IRQ mode)"
+    log ""
+
+    # Compute baud from IBRD/FBRD
+    ibrd_n=$(printf '%d' "$ibrd")
+    fbrd_n=$(printf '%d' "$fbrd")
+    if [ "$ibrd_n" -gt 0 ]; then
+        # PL011 baud = UARTCLK / (16 * (IBRD + FBRD/64))
+        # UARTCLK on Hi3518EV200 = 6MHz (24MHz / 4) or 24MHz depending on config
+        log "  Baud divisor: IBRD=$ibrd_n, FBRD=$fbrd_n"
+        log "  If UARTCLK=6MHz:  baud ~ $(( 6000000 / (16 * ibrd_n) ))"
+        log "  If UARTCLK=24MHz: baud ~ $(( 24000000 / (16 * ibrd_n) ))"
+    fi
+    log ""
+
+    log "--- PL011 UART2 Registers (base 0x200a0000) ---"
+    cr2=$(devmem 0x200a0030 32)
+    imsc2=$(devmem 0x200a0038 32)
+    log "  CR   (0x30) = $cr2"
+    log "  IMSC (0x38) = $imsc2"
+    log ""
+
+    log "--- Device nodes ---"
+    ls -la /dev/ttyAMA* 2>&1 | while read line; do log "  $line"; done
+    log ""
+
+    log "--- Kernel UART messages ---"
+    dmesg 2>/dev/null | grep -i "ttyAMA\|uart\|pl011\|serial" | while read line; do log "  $line"; done
+    log ""
+
+    log "--- /proc/interrupts (UART) ---"
+    grep -i "uart\|serial\|pl011" /proc/interrupts 2>/dev/null | while read line; do log "  $line"; done
+    # Also show IRQ 30 (UART1) directly
+    grep "^ *30:" /proc/interrupts 2>/dev/null | while read line; do log "  IRQ30: $line"; done
+    log ""
+
+    log "State recorded to $LOG"
+}
+
+# ---------------------------------------------------------------
+# Phase 2: Setup — ensure UART1 pins at mux=0 (reset default)
+# ---------------------------------------------------------------
+setup_uart1() {
+    log "=== Setting up UART1 for MCU ==="
+
+    # Ensure UART1 clock is enabled (bit 16)
+    val=$(devmem $CRG_REG 32)
+    num=$(printf '%d' "$val")
+    if [ $(( (num >> 16) & 1 )) -eq 0 ]; then
+        new=$(printf '0x%08X' $((num | 0x10000)))
+        log "Enabling UART1 clock: $val -> $new"
+        devmem $CRG_REG 32 "$new"
+    else
+        log "UART1 clock already enabled"
+    fi
+
+    # Ensure UART1 pins at mux=0 (UART1 function on EV200)
+    # 0xC4 = UART1_RXD, 0xC8 = UART1_TXD at mux=0
+    for info in "0xc4:UART1_RXD" "0xc8:UART1_TXD"; do
+        off=$(echo "$info" | cut -d: -f1)
+        func=$(echo "$info" | cut -d: -f2)
+        addr=$(printf '0x%x' $((IOCFG_BASE + off)))
+        cur=$(devmem "$addr" 32)
+        if [ "$cur" != "0x00000000" ]; then
+            log "Resetting $addr ($func) from $cur to 0"
+            devmem "$addr" 32 0
+        else
+            log "$addr ($func) already at mux=0"
+        fi
+    done
+
+    # Also ensure 0xBC (CTSN) and 0xC0 (RTSN) at mux=0 for full UART1
+    for info in "0xbc:UART1_CTSN" "0xc0:UART1_RTSN"; do
+        off=$(echo "$info" | cut -d: -f1)
+        func=$(echo "$info" | cut -d: -f2)
+        addr=$(printf '0x%x' $((IOCFG_BASE + off)))
+        cur=$(devmem "$addr" 32)
+        if [ "$cur" != "0x00000000" ]; then
+            log "Resetting $addr ($func) from $cur to 0"
+            devmem "$addr" 32 0
+        else
+            log "$addr ($func) already at mux=0"
+        fi
+    done
+
+    # Configure ttyAMA1
+    stty -F /dev/ttyAMA1 115200 raw -echo cs8 -cstopb -parenb cread clocal -crtscts
+    log "ttyAMA1 configured: 115200 8N1"
+
+    # Verify PL011 is enabled after opening
+    cr=$(devmem 0x20090030 32)
+    log "UART1 CR after stty = $cr (expect 0x00000301 for UARTEN+TXE+RXE)"
+
+    log ""
+    log "Setup complete. UART1 should be active on:"
+    log "  IOCFG pin 49 (0xC4) = UART1_RXD (SoC receives from MCU)"
+    log "  IOCFG pin 50 (0xC8) = UART1_TXD (SoC transmits to MCU)"
+    log ""
+    log "If MCU is on GPIO 51/52 instead of 49/50, run: $0 scan"
+}
+
+# ---------------------------------------------------------------
+# Phase 3: Listen for MCU data
+# ---------------------------------------------------------------
+listen_uart1() {
+    stty -F /dev/ttyAMA1 115200 raw -echo cs8 -cstopb -parenb cread clocal -crtscts
+    log "=== Listening on ttyAMA1 (115200 8N1) — trigger MCU now ==="
+    log "Press Ctrl-C to stop"
+    cat /dev/ttyAMA1 | xxd
+}
+
+# ---------------------------------------------------------------
+# Phase 4: Brute-force scan — try each IOCFG pin as UART1 TX
+# ---------------------------------------------------------------
+scan_uart1_tx() {
+    log "=== Scanning IOCFG 0xB8-0xD4 for UART1 TX signal ==="
+    log ""
+    log "This sends data on ttyAMA1 and checks which pin goes LOW."
+    log "UART TX idles HIGH; during transmission it pulses LOW."
+    log ""
+
+    # First, configure ttyAMA1
+    stty -F /dev/ttyAMA1 115200 raw -echo cs8 -cstopb -parenb cread clocal -crtscts
+
+    # Save current mux values
+    log "Saving current mux state..."
+    saved=""
+    for off in 0xb8 0xbc 0xc0 0xc4 0xc8 0xcc 0xd0 0xd4; do
+        addr=$(printf '0x%x' $((IOCFG_BASE + off)))
+        val=$(devmem "$addr" 32)
+        saved="$saved $off=$val"
+        log "  $addr = $val"
+    done
+    log ""
+
+    # For each pin, try mux=0 (expected UART1 function) and send data
+    # Export GPIOs 46-53 as inputs for reading
+    for gpio in 46 47 48 49 50 51 52 53; do
+        echo "$gpio" > /sys/class/gpio/export 2>/dev/null
+        echo "in" > /sys/class/gpio/gpio${gpio}/direction 2>/dev/null
+    done
+
+    log "Testing each pin at mux=0..."
+    log "Pin  GPIO  Offset  Before  During  Result"
+    log "---  ----  ------  ------  ------  ------"
+
+    for info in \
+        "46:0xb8" "47:0xbc" "48:0xc0" "49:0xc4" \
+        "50:0xc8" "51:0xcc" "52:0xd0" "53:0xd4"
+    do
+        gpio=$(echo "$info" | cut -d: -f1)
+        off=$(echo "$info" | cut -d: -f2)
+        addr=$(printf '0x%x' $((IOCFG_BASE + off)))
+
+        # Set pin to mux=0
+        devmem "$addr" 32 0
+
+        # Brief delay for pin to settle
+        usleep 10000 2>/dev/null || sleep 0.01
+
+        # Read GPIO value before sending
+        before=$(cat /sys/class/gpio/gpio${gpio}/value 2>/dev/null || echo "?")
+
+        # Send data on ttyAMA1 (background) and read GPIO during
+        echo -ne '\xff\xff\xff\xff\xff\xff\xff\xff' > /dev/ttyAMA1 &
+        usleep 500 2>/dev/null || sleep 0.001
+        during=$(cat /sys/class/gpio/gpio${gpio}/value 2>/dev/null || echo "?")
+        wait
+
+        if [ "$before" = "1" ] && [ "$during" = "0" ]; then
+            result="<<< UART1_TXD FOUND >>>"
+        elif [ "$before" = "?" ]; then
+            result="(GPIO export failed)"
+        else
+            result="-"
+        fi
+
+        log "  $gpio   $gpio    $off    $before       $during     $result"
+    done
+
+    log ""
+    log "Now testing mux=1 for each pin..."
+    log "Pin  GPIO  Offset  Before  During  Result"
+    log "---  ----  ------  ------  ------  ------"
+
+    for info in \
+        "46:0xb8" "47:0xbc" "48:0xc0" "49:0xc4" \
+        "50:0xc8" "51:0xcc" "52:0xd0" "53:0xd4"
+    do
+        gpio=$(echo "$info" | cut -d: -f1)
+        off=$(echo "$info" | cut -d: -f2)
+        addr=$(printf '0x%x' $((IOCFG_BASE + off)))
+
+        devmem "$addr" 32 1
+        usleep 10000 2>/dev/null || sleep 0.01
+
+        before=$(cat /sys/class/gpio/gpio${gpio}/value 2>/dev/null || echo "?")
+
+        echo -ne '\xff\xff\xff\xff\xff\xff\xff\xff' > /dev/ttyAMA1 &
+        usleep 500 2>/dev/null || sleep 0.001
+        during=$(cat /sys/class/gpio/gpio${gpio}/value 2>/dev/null || echo "?")
+        wait
+
+        if [ "$before" = "1" ] && [ "$during" = "0" ]; then
+            result="<<< UART1_TXD FOUND (mux=1) >>>"
+        elif [ "$before" = "?" ]; then
+            result="(GPIO export failed)"
+        else
+            result="-"
+        fi
+
+        log "  $gpio   $gpio    $off    $before       $during     $result"
+    done
+
+    # Restore mux values
+    log ""
+    log "Restoring original mux state..."
+    for pair in $saved; do
+        off=$(echo "$pair" | cut -d= -f1)
+        val=$(echo "$pair" | cut -d= -f2)
+        addr=$(printf '0x%x' $((IOCFG_BASE + off)))
+        devmem "$addr" 32 "$val"
+    done
+
+    # Unexport GPIOs
+    for gpio in 46 47 48 49 50 51 52 53; do
+        echo "$gpio" > /sys/class/gpio/unexport 2>/dev/null
+    done
+
+    log "Scan complete. Results in $LOG"
+}
+
+# ---------------------------------------------------------------
+# Main
+# ---------------------------------------------------------------
+> "$LOG"
+
+case "${1:-}" in
+    setup)
+        record_state
+        setup_uart1
+        ;;
+    listen)
+        listen_uart1
+        ;;
+    scan)
+        scan_uart1_tx
+        ;;
+    *)
+        record_state
+        ;;
+esac
diff --git a/general/overlay/usr/sbin/uart-fullscan.sh b/general/overlay/usr/sbin/uart-fullscan.sh
new file mode 100755
index 00000000..38c4e636
--- /dev/null
+++ b/general/overlay/usr/sbin/uart-fullscan.sh
@@ -0,0 +1,72 @@
+#!/bin/sh
+# uart-fullscan.sh [start_pin] — Scan IOCFG pins for UART1/UART2 TX
+#
+# SAFE: Only touches pins currently at mux=0 AND not in the skip list.
+# Skips SDIO/WiFi region (pins 26-43) to avoid killing connectivity.
+# Each pin is restored immediately after testing.
+#
+# Usage:
+#   uart-fullscan.sh         — scan all safe pins
+#   uart-fullscan.sh 44      — start from pin 44
+
+IOCFG=0x200f0000
+PATTERN='\xaa\x55\xaa\x55\xaa\x55\xaa\x55\xaa\x55\xaa\x55\xaa\x55\xaa\x55'
+START_PIN=${1:-0}
+
+# Skip list: pins known to be dangerous or already scanned
+# 26-43: SDIO/MMC/WiFi region (kills WiFi when touched)
+# Sensor and RMII pins are non-zero mux so auto-skipped
+is_skipped() {
+    pin=$1
+    # SDIO/WiFi region
+    if [ $pin -ge 26 ] && [ $pin -le 43 ]; then
+        return 0
+    fi
+    return 1
+}
+
+stty -F /dev/ttyAMA1 115200 raw -echo cs8 -cstopb -parenb cread clocal -crtscts 2>/dev/null
+stty -F /dev/ttyAMA2 115200 raw -echo cs8 -cstopb -parenb cread clocal -crtscts 2>/dev/null
+
+echo "=== Safe IOCFG scan (start_pin=$START_PIN, skipping 26-43) ==="
+echo ""
+
+off=$((START_PIN * 4))
+while [ $off -le 260 ]; do
+    pin=$((off / 4))
+    hex=$(printf '0x%03x' $off)
+    addr=$(printf '0x%x' $((IOCFG + off)))
+
+    if is_skipped $pin; then
+        echo "  pin $pin ($hex) [SKIP - SDIO region]"
+        off=$((off + 4))
+        continue
+    fi
+
+    val=$(devmem "$addr" 32)
+    num=$(printf '%d' "$val")
+
+    if [ $num -ne 0 ]; then
+        echo "  pin $pin ($hex) = $val [SKIP - in use]"
+        off=$((off + 4))
+        continue
+    fi
+
+    # Safe to test — try mux 1-7
+    for mux in 1 2 3 4 5 6 7; do
+        devmem "$addr" 32 $mux
+        echo -ne "$PATTERN" > /dev/ttyAMA1
+        usleep 30000 2>/dev/null || true
+        echo -ne "$PATTERN" > /dev/ttyAMA2
+        usleep 30000 2>/dev/null || true
+    done
+
+    # Restore immediately
+    devmem "$addr" 32 0
+    echo "  pin $pin ($hex) done"
+
+    off=$((off + 4))
+done
+
+echo ""
+echo "Scan complete."
