diff --git a/general/overlay/etc/init.d/S36pinmux b/general/overlay/etc/init.d/S36pinmux
new file mode 100755
index 00000000..a9479ae9
--- /dev/null
+++ b/general/overlay/etc/init.d/S36pinmux
@@ -0,0 +1,42 @@
+#!/bin/sh
+# Configure Hi3518EV200 pin mux registers.
+#
+# sys_config.ko does this for known sensors (ar0130, ov9712, etc.) but
+# skips the full pinmux block when it gets an unrecognised sensor name
+# like jxh62. Write the registers directly here so they are always set.
+#
+# Register base: 0x200f0000  Stride: 4 bytes per pin (pinctrl-single)
+# Value 0 = first function (often GPIO), 1 = first alternate, 2 = second...
+#
+# Sources:
+#   - Hi3518 DataSheet (HiSilicon, 2013-02-05), section 2 Hardware
+#   - Disassembly of pinmux_hi3518e() in sys_config.ko (pin_mux_select=0)
+#   - Hi3518EV20x.dtsi gpio-ranges cross-reference
+
+case "$1" in
+    start)
+        # UART2 — MCU communication (STC15W408AS)
+        # Pin 51 (IOCFG 0xCC) = UART2_TXD at mux=3
+        # Pin 52 (IOCFG 0xD0) = UART2_RXD at mux=3
+        # Confirmed by dumping original firmware IOCFG register state.
+        # 0x020-0x02C are RMII Ethernet on EV200, NOT UART1 as V100 datasheet suggests.
+        devmem 0x200f00cc 32 3
+        devmem 0x200f00d0 32 3
+
+        # Platform bus pins set by sys_config.ko pin_mux_select=0 for all
+        # known sensors (reg4-7 and reg13-15 — exact functions vary by board)
+        devmem 0x200f0010 32 1
+        devmem 0x200f0014 32 1
+        devmem 0x200f0018 32 1
+        devmem 0x200f001c 32 1
+        devmem 0x200f0034 32 1
+        devmem 0x200f0038 32 1
+        devmem 0x200f003c 32 1
+        ;;
+    stop)
+        ;;
+    *)
+        echo "Usage: $0 {start|stop}"
+        exit 1
+        ;;
+esac
