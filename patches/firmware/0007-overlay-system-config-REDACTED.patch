diff --git a/general/overlay/usr/sbin/origfw-dump.sh b/general/overlay/usr/sbin/origfw-dump.sh
new file mode 100644
index 00000000..b4b5bf9e
--- /dev/null
+++ b/general/overlay/usr/sbin/origfw-dump.sh
@@ -0,0 +1,120 @@
+#!/bin/sh
+# origfw-dump.sh — Run on ORIGINAL firmware to capture full register state
+# Transfer this script to the device and run before/after IPServer starts
+#
+# Usage:
+#   origfw-dump.sh boot    — run at boot before IPServer (from serial console)
+#   origfw-dump.sh running — run while IPServer is communicating with MCU
+#   origfw-dump.sh feed    — run, then trigger a feed, captures interrupt counts
+
+OUT="/tmp/origfw-${1:-boot}.log"
+
+log() {
+    echo "$@"
+    echo "$@" >> "$OUT"
+}
+
+log "=== Original FW Register Dump — mode=${1:-boot} — $(date) ==="
+log ""
+
+# ---------------------------------------------------------------
+# ALL 66 IOCFG registers (0x000-0x104)
+# ---------------------------------------------------------------
+log "--- IOCFG 0x200f0000: ALL registers (0x000-0x108) ---"
+log "Offset  Value     Pin  Notes"
+off=0
+while [ $off -le 264 ]; do
+    hex=$(printf '0x%03x' $off)
+    addr=$(printf '0x%x' $((0x200f0000 + off)))
+    val=$(devmem "$addr" 32)
+    pin=$((off / 4))
+    log "  $hex    $val   pin$pin"
+    off=$((off + 4))
+done
+log ""
+
+# ---------------------------------------------------------------
+# CRG clock/reset registers
+# ---------------------------------------------------------------
+log "--- CRG Registers ---"
+for r in 0xe0 0xe4 0xe8 0xec; do
+    addr=$(printf '0x%x' $((0x20030000 + r)))
+    val=$(devmem "$addr" 32)
+    log "  $addr = $val"
+done
+log ""
+
+# ---------------------------------------------------------------
+# PL011 UART1 (0x20090000) full register set
+# ---------------------------------------------------------------
+log "--- PL011 UART1 (0x20090000) ---"
+for r in 0x00 0x04 0x18 0x24 0x28 0x2c 0x30 0x34 0x38 0x3c 0x44 0x48; do
+    addr=$(printf '0x%x' $((0x20090000 + r)))
+    val=$(devmem "$addr" 32)
+    log "  $addr = $val"
+done
+log ""
+
+# ---------------------------------------------------------------
+# PL011 UART2 (0x200a0000) full register set
+# ---------------------------------------------------------------
+log "--- PL011 UART2 (0x200a0000) ---"
+for r in 0x00 0x04 0x18 0x24 0x28 0x2c 0x30 0x34 0x38 0x3c 0x44 0x48; do
+    addr=$(printf '0x%x' $((0x200a0000 + r)))
+    val=$(devmem "$addr" 32)
+    log "  $addr = $val"
+done
+log ""
+
+# ---------------------------------------------------------------
+# GPIO controller registers for GPIO6 (pins 48-55)
+# ---------------------------------------------------------------
+log "--- GPIO6 (0x206f0000) — covers pins 48-55 ---"
+for r in 0x000 0x3fc 0x400 0x404 0x408 0x410; do
+    addr=$(printf '0x%x' $((0x206f0000 + r)))
+    val=$(devmem "$addr" 32)
+    log "  $addr = $val"
+done
+log ""
+
+# Also GPIO5 for reference
+log "--- GPIO5 (0x206e0000) — covers pins 40-47 ---"
+for r in 0x000 0x3fc 0x400 0x404 0x408 0x410; do
+    addr=$(printf '0x%x' $((0x206e0000 + r)))
+    val=$(devmem "$addr" 32)
+    log "  $addr = $val"
+done
+log ""
+
+# ---------------------------------------------------------------
+# Interrupt state
+# ---------------------------------------------------------------
+log "--- /proc/interrupts ---"
+cat /proc/interrupts >> "$OUT" 2>&1
+log ""
+
+# ---------------------------------------------------------------
+# Process list (to see if IPServer is running)
+# ---------------------------------------------------------------
+log "--- Processes ---"
+ps | grep -i "ipserver\|ipc\|uart\|serial\|jiake" >> "$OUT" 2>&1
+log ""
+
+# ---------------------------------------------------------------
+# Open file descriptors on ttyAMA*
+# ---------------------------------------------------------------
+log "--- Open ttyAMA fds ---"
+ls -la /proc/*/fd 2>/dev/null | grep ttyAMA >> "$OUT" 2>&1
+# Also check via fuser if available
+fuser /dev/ttyAMA1 /dev/ttyAMA2 2>&1 | while read line; do log "  $line"; done
+log ""
+
+# ---------------------------------------------------------------
+# dmesg UART related
+# ---------------------------------------------------------------
+log "--- dmesg (UART/serial) ---"
+dmesg 2>/dev/null | grep -i "ttyAMA\|uart\|pl011\|serial" >> "$OUT" 2>&1
+log ""
+
+log "Done. Output saved to $OUT"
+log "Transfer with: cat $OUT  (over serial) or save to SD"
