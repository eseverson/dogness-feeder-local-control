+            ipctool i2cset $I 0x34 0x2c; ipctool i2cset $I 0x38 0x40
+            ipctool i2cset $I 0x68 0x00; ipctool i2cset $I 0x6a 0x1f
+            ipctool i2cset $I 0x70 0x89; ipctool i2cset $I 0x71 0x4a
+            ipctool i2cset $I 0x72 0x48; ipctool i2cset $I 0x73 0x43
+            ipctool i2cset $I 0x74 0x52; ipctool i2cset $I 0x75 0x2b
