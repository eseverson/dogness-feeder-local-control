+#   IR LED:  group 0, pin 0 = 0
+#   IR cut:  group 4, pin 5 = 37
+#   Main LED: board-specific, set to -1 to disable
+ir_led_gpio     = 0
+ir_cut_gpio     = 37
+main_led_gpio   = 2
+
+# Media URLs published to MQTT on connect
+# Leave blank to auto-detect from device IP
+stream_url      =
+snapshot_url    =
+audio_url       =
+play_audio_url  =
diff --git a/general/package/catd/files/motion.sh b/general/package/catd/files/motion.sh
new file mode 100755
index 00000000..a5dc79da
--- /dev/null
+++ b/general/package/catd/files/motion.sh
@@ -0,0 +1,30 @@
+#!/bin/sh
+# /usr/sbin/motion.sh — called by majestic on motion detection
+# Args: $1 $2 $3 $4 = bounding box (x y w h)
+# Publishes motion event to MQTT for Home Assistant
+
+TOPIC="homeassistant/cat/motion"
+BROKER=$(sed -n 's/^broker_host[[:space:]]*=[[:space:]]*//p' /etc/catd.conf)
+PORT=$(sed -n 's/^broker_port[[:space:]]*=[[:space:]]*//p' /etc/catd.conf)
+
+[ -z "$BROKER" ] && BROKER="192.168.1.2"
+[ -z "$PORT" ] && PORT="1883"
+
+TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
+
+mosquitto_pub -h "$BROKER" -p "$PORT" \
+  -t "$TOPIC" -r \
+  -m "{\"motion\":true,\"ts\":\"$TIMESTAMP\",\"region\":[$1,$2,$3,$4]}"
+
+# Clear motion after 30s (kill any previous pending clear)
+PIDFILE="/tmp/motion_clear.pid"
+[ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null
+
+(
+  echo $$ > "$PIDFILE"
+  sleep 30
+  mosquitto_pub -h "$BROKER" -p "$PORT" \
+    -t "$TOPIC" -r \
+    -m "{\"motion\":false,\"ts\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"region\":[0,0,0,0]}"
+  rm -f "$PIDFILE"
+) &
