diff --git a/general/package/catd/files/S85catd b/general/package/catd/files/S85catd
new file mode 100644
index 00000000..837535f5
--- /dev/null
+++ b/general/package/catd/files/S85catd
@@ -0,0 +1,47 @@
+#!/bin/sh
+
+DAEMON="catd"
+PIDFILE="/var/run/$DAEMON.pid"
+ARGS="-c /etc/catd.conf"
+
+start() {
+	printf "Starting %s: " "$DAEMON"
+	start-stop-daemon -b -m -S -q -p "$PIDFILE" \
+		-x "/usr/sbin/$DAEMON" -n "$DAEMON" -- $ARGS
+	[ $? -eq 0 ] && echo "OK" || echo "FAIL"
+}
+
+stop() {
+	printf "Stopping %s: " "$DAEMON"
+	# Match by name, not just the pidfile — the pidfile only ever holds the
+	# most-recently-started PID, so a pidfile-only -K leaves stray instances
+	# alive (which then fight over the MQTT client ID). -n reaps them all.
+	start-stop-daemon -K -q -n "$DAEMON"
+	# Safety net: if catd wedges on shutdown (MQTT thread join), SIGTERM
+	# alone won't kill it and stop/start cycles stack up duplicate instances
+	# that fight over the MQTT client ID. Escalate to SIGKILL after a short
+	# grace period so stop can never leave a stray daemon behind.
+	i=0
+	while pidof "$DAEMON" >/dev/null 2>&1 && [ "$i" -lt 5 ]; do
+		sleep 1
+		i=$((i + 1))
+	done
+	pidof "$DAEMON" >/dev/null 2>&1 && killall -9 "$DAEMON" 2>/dev/null
+	rm -f "$PIDFILE"
+	echo "OK"
+}
+
+case "$1" in
+	start|stop)
+		"$1"
+		;;
+	restart)
+		stop
+		sleep 1
+		start
+		;;
+	*)
+		echo "Usage: $0 {start|stop|restart}"
+		exit 1
+		;;
+esac
