+		 "\"ic\":\"mdi:brightness-6\","
+		 "\"ent_cat\":\"diagnostic\","
+		 "\"stat_cla\":\"measurement\","
+		 "%s"
+		 "}",
+		 cfg.device_id, dev);
+	ha_publish("sensor", "brightness", buf);
+
+	/* Per-slot schedule entities (3 entities each × 6 slots) */
+	for (int s = 1; s <= NUM_MEAL_SLOTS; s++)
+		publish_schedule_discovery(s, dev);
+
+	log_info("catd: published HA discovery for %s\n", cfg.device_id);
+}
+
+/* ------------------------------------------------------------------ */
+/* MCU command helpers                                                 */
+/* ------------------------------------------------------------------ */
+
+static int mcu_set_time_now(void)
+{
+	pthread_mutex_lock(&g_uart_lock);
+	int ret = uart_send_set_time(g_uart_fd, time(NULL));
+	pthread_mutex_unlock(&g_uart_lock);
+	if (ret == 0) g_last_time_sync = time(NULL);
+	return ret;
+}
+
+static int mcu_get_time(void)
+{
+	pthread_mutex_lock(&g_uart_lock);
+	int ret = uart_send_get_time(g_uart_fd);
+	pthread_mutex_unlock(&g_uart_lock);
+	return ret;
+}
+
+static int mcu_get_version(void)
+{
+	pthread_mutex_lock(&g_uart_lock);
+	int ret = uart_send_get_version(g_uart_fd);
+	pthread_mutex_unlock(&g_uart_lock);
+	return ret;
+}
+
+static int mcu_motor_test(void)
+{
+	pthread_mutex_lock(&g_uart_lock);
+	int ret = uart_send_motor_test(g_uart_fd);
+	pthread_mutex_unlock(&g_uart_lock);
+	return ret;
+}
+
+static int mcu_read_schedule(int slot)
+{
+	pthread_mutex_lock(&g_uart_lock);
+	int ret = uart_send_read_schedule(g_uart_fd, slot);
+	pthread_mutex_unlock(&g_uart_lock);
+	return ret;
+}
+
+/*
+ * Write a slot to the MCU. We use the cmd=0x01 / A5 A7 7F (auto-feed) record
+ * form because the cmd=0x02 / 12 01 01 (meal-record) SET form is rejected
+ * over UART (per MCU_PROTOCOL.md §4.5). Both forms produce a recurring-daily
+ * schedule when stored, so this is functionally equivalent.
+ *
+ * `portions` is the user-facing 1..10 value; we multiply by 10 here to get
+ * the MCU's native weight unit (which it validates as ≥ 10). The raw weight
+ * never appears outside this function.
+ */
+static int mcu_write_slot(int slot, int hour, int minute, int portions,
+			  int audio_idx, int enabled)
+{
+	int wire_weight = portions * 10;
+	pthread_mutex_lock(&g_uart_lock);
+	int ret = uart_send_auto_feed(g_uart_fd, hour, minute, wire_weight,
+				       audio_idx, slot, enabled);
+	pthread_mutex_unlock(&g_uart_lock);
+	return ret;
+}
+
+static int mcu_manual_feed(int weight)
+{
+	pthread_mutex_lock(&g_uart_lock);
+	int ret = uart_send_manual_feed(g_uart_fd, (uint8_t)weight);
+	pthread_mutex_unlock(&g_uart_lock);
+	return ret;
+}
+
+static void request_full_schedule(void)
+{
+	mcu_read_schedule(0);  /* slot=0 → MCU dumps all 8 */
+}
+
+/*
+ * Push every loaded schedule slot to the MCU so the MCU's table matches
+ * our persisted state. Called once on startup. Slots that were never
+ * configured (kind=EMPTY) are skipped — we don't want to clobber whatever
+ * factory defaults the MCU has for them.
+ */
+static void mcu_push_saved_schedule(void)
+{
+	for (int slot = 1; slot <= NUM_MEAL_SLOTS; slot++) {
+		struct mcu_slot *s = &g_schedule[slot];
+		if (s->kind == MCU_SLOT_EMPTY) continue;
+		/* The auto-feed wire format requires weight ≥ 10 in MCU units
+		 * (= 1 portion) even when the slot is disabled. */
+		int p = (s->weight >= 1) ? s->weight : 1;
+		mcu_write_slot(slot, s->hour, s->minute, p,
+			       s->audio_idx, s->enabled);
+		usleep(50 * 1000);
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* MQTT command handlers                                               */
+/* ------------------------------------------------------------------ */
+
+static int parse_on_off(const char *p)
+{
+	return (!strcmp(p, "ON") || !strcmp(p, "true") || !strcmp(p, "1"));
+}
+
+/* "HH:MM" or "HH:MM:SS" → out_h, out_m. Returns 0 on success. */
+static int parse_hhmm(const char *s, int *out_h, int *out_m)
+{
+	int h = -1, m = -1;
+	if (sscanf(s, "%d:%d", &h, &m) != 2) return -1;
+	if (h < 0 || h > 23 || m < 0 || m > 59) return -1;
+	*out_h = h; *out_m = m;
+	return 0;
+}
+
+static void handle_feed_amount(const char *payload)
+{
+	int amount = (int)(strtof(payload, NULL) + 0.5f);
+	if (amount < 1) amount = 1;
+	if (amount > 10) amount = 10;
+
+	if (amount == g_feed_amount) return;
+	g_feed_amount = amount;
+
+	char buf[16];
+	snprintf(buf, sizeof(buf), "%d.0", g_feed_amount);
+	mqtt_publish(TOPIC_PREFIX "feed/amount", buf, 1);
+	log_info("catd: feed amount set to %d\n", g_feed_amount);
+	state_save();
+}
+
+static void handle_feed_command(const char *payload)
+{
+	(void)payload;
+	if (g_feed_pending) {
+		log_info("catd: feed already in progress, ignoring\n");
+		publish_feed_status("busy");
+		return;
+	}
+	int mcu_weight = g_feed_amount * 10;
+	log_info("catd: feed triggered, amount=%d mcu_weight=%d\n",
+		 g_feed_amount, mcu_weight);
+	publish_feed_status("feeding");
+
+	if (mcu_manual_feed(mcu_weight) < 0) {
+		log_err("catd: failed to send feed command\n");
+		publish_feed_status("error");
+		return;
+	}
+	g_feed_pending = 1;
+	g_feed_start = time(NULL);
+}
+
+static void handle_ir_led_set(const char *payload)
+{
+	int state = parse_on_off(payload);
+	gpio_write(cfg.ir_led_gpio, state);
+	g_ir_led_state = state;
+	mqtt_publish(TOPIC_PREFIX "ir_led/state", state ? "ON" : "OFF", 1);
+	state_save();
+}
+
+static void handle_ir_cut_set(const char *payload)
+{
+	int state = parse_on_off(payload);
+	gpio_write(cfg.ir_cut_gpio, state);
+	g_ir_cut_state = state;
+	mqtt_publish(TOPIC_PREFIX "ir_cut/state", state ? "ON" : "OFF", 1);
+	state_save();
+}
+
+static void handle_main_led_set(const char *payload)
+{
+	if (cfg.main_led_gpio < 0) return;
+	int state = parse_on_off(payload);
+	gpio_write(cfg.main_led_gpio, state);
+	g_main_led_state = state;
+	mqtt_publish(TOPIC_PREFIX "led/state", state ? "ON" : "OFF", 1);
+	state_save();
+}
+
+static void handle_light_monitor_set(const char *payload)
+{
+	int state = parse_on_off(payload);
+	if (set_light_monitor(state) < 0) return;
+	g_light_monitor_state = state;
+	mqtt_publish(TOPIC_PREFIX "light_monitor/state", state ? "ON" : "OFF", 1);
+	state_save();
+}
+
+static void handle_sync_time(const char *payload)
+{
+	(void)payload;
+	if (mcu_set_time_now() == 0) {
+		log_info("catd: pushed host time to MCU\n");
+		mcu_get_time();  /* readback to refresh sensor */
+	}
+}
+
+static void handle_motor_test(const char *payload)
+{
+	(void)payload;
+	if (mcu_motor_test() == 0)
+		log_info("catd: motor self-test triggered\n");
+}
+
+static void handle_refresh_schedule(const char *payload)
+{
+	(void)payload;
+	log_info("catd: refresh schedule requested\n");
+	request_full_schedule();
+}
+
+static void handle_clear_all_schedules(const char *payload)
+{
+	(void)payload;
+	log_info("catd: clearing all schedule slots\n");
+	for (int slot = 1; slot <= NUM_MEAL_SLOTS; slot++) {
+		struct mcu_slot *s = &g_schedule[slot];
+		/* Preserve existing HH:MM/portions so the slot still has a
+		 * valid schedule on the wire (≥ 1 portion required); just flip
+		 * the enable flag so it never fires. */
+		int h = s->hour;
+		int m = s->minute;
+		int p = (s->weight >= 1) ? s->weight : 1;
+		mcu_write_slot(slot, h, m, p, 0 /* audio */, 0 /* enabled */);
+		usleep(50 * 1000);  /* small gap so the MCU keeps up */
+		s->kind = MCU_SLOT_AUTOFEED;
+		s->slot_num = slot;
+		s->hour = h; s->minute = m;
+		s->weight = p;
+		s->audio_idx = 0;
+		s->enabled = 0;
+		publish_schedule_slot(slot);
+	}
+	state_save();
+	request_full_schedule();
+}
+
+/*
+ * Schedule slot updates from HA.
+ * Topic: homeassistant/cat/schedule/N/{time,weight,enabled}/set
+ * We update our cached g_schedule[N] in-place, then push the full record
+ * to the MCU via uart_send_meal_slot.
+ */
+static void handle_schedule_set(int slot, const char *field, const char *payload)
+{
+	if (slot < 1 || slot > NUM_MEAL_SLOTS) return;
+	struct mcu_slot *s = &g_schedule[slot];
+
+	/* Default to autofeed kind if we haven't seen the slot yet — that's the
+	 * only form the MCU accepts via UART writes. */
+	if (s->kind == MCU_SLOT_EMPTY) {
+		s->kind     = MCU_SLOT_AUTOFEED;
+		s->slot_num = slot;
+	}
+
+	if (!strcmp(field, "time")) {
+		int h, m;
+		if (parse_hhmm(payload, &h, &m) < 0) {
+			log_err("catd: bad time payload for slot %d: %s\n", slot, payload);
+			return;
+		}
+		s->hour = h;
+		s->minute = m;
+	} else if (!strcmp(field, "weight")) {
+		/* HA sends portions (1..10); we keep that scale internally */
+		int p = atoi(payload);
+		if (p < 1) p = 1;
+		if (p > 10) p = 10;
+		s->weight = p;
+	} else if (!strcmp(field, "enabled")) {
+		s->enabled = parse_on_off(payload);
+	} else {
+		return;
+	}
+
+	log_info("catd: slot %d update — %02d:%02d weight=%d enabled=%d audio=%d\n",
+		 slot, s->hour, s->minute, s->weight, s->enabled, s->audio_idx);
+
+	if (mcu_write_slot(slot, s->hour, s->minute, s->weight,
+			    s->audio_idx, s->enabled) == 0) {
+		publish_schedule_slot(slot);
+		state_save();
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* MQTT callbacks                                                      */
+/* ------------------------------------------------------------------ */
+
+static void on_connect(struct mosquitto *mosq, void *ud, int rc)
+{
+	(void)ud;
+	if (rc != 0) {
+		log_err("catd: MQTT connect failed: %s\n", mosquitto_connack_string(rc));
+		return;
+	}
+	log_info("catd: MQTT connected to %s:%d\n", cfg.broker_host, cfg.broker_port);
+
+	mqtt_publish(TOPIC_PREFIX "status", "online", 1);
+
+	g_ir_led_state = gpio_read(cfg.ir_led_gpio);
+	if (g_ir_led_state < 0) g_ir_led_state = 0;
+	g_ir_cut_state = gpio_read(cfg.ir_cut_gpio);
+	if (g_ir_cut_state < 0) g_ir_cut_state = 0;
+	mqtt_publish(TOPIC_PREFIX "ir_led/state", g_ir_led_state ? "ON" : "OFF", 1);
+	mqtt_publish(TOPIC_PREFIX "ir_cut/state", g_ir_cut_state ? "ON" : "OFF", 1);
+
+	int lm = fetch_light_monitor();
+	g_light_monitor_state = (lm > 0) ? 1 : 0;
+	mqtt_publish(TOPIC_PREFIX "light_monitor/state",
+		     g_light_monitor_state ? "ON" : "OFF", 1);
+
+	if (cfg.main_led_gpio >= 0) {
+		g_main_led_state = gpio_read(cfg.main_led_gpio);
+		if (g_main_led_state < 0) g_main_led_state = 0;
+		mqtt_publish(TOPIC_PREFIX "led/state", g_main_led_state ? "ON" : "OFF", 1);
+	}
+
+	if (cfg.stream_url[0])     mqtt_publish(TOPIC_PREFIX "video/stream", cfg.stream_url, 1);
+	if (cfg.snapshot_url[0])   mqtt_publish(TOPIC_PREFIX "video/snapshot", cfg.snapshot_url, 1);
+	if (cfg.audio_url[0])      mqtt_publish(TOPIC_PREFIX "audio/stream", cfg.audio_url, 1);
+	if (cfg.play_audio_url[0]) mqtt_publish(TOPIC_PREFIX "audio/play", cfg.play_audio_url, 1);
+
+	publish_feed_status("idle");
+	/* Default chute = clear until MCU tells us otherwise via cmd=0x11. */
+	mqtt_publish(TOPIC_PREFIX "chute/blocked", "false", 1);
+	mqtt_publish(TOPIC_PREFIX "motion",
+		     "{\"motion\":false,\"ts\":\"\",\"region\":[0,0,0,0]}", 1);
+	{
+		char buf[16];
+		snprintf(buf, sizeof(buf), "%d.0", g_feed_amount);
+		mqtt_publish(TOPIC_PREFIX "feed/amount", buf, 1);
+	}
+
+	/* Subscribe to all command topics */
+	mosquitto_subscribe(mosq, NULL, TOPIC_PREFIX "feed/amount/set", 1);
+	mosquitto_subscribe(mosq, NULL, TOPIC_PREFIX "feed/command", 1);
+	mosquitto_subscribe(mosq, NULL, TOPIC_PREFIX "ir_led/set", 1);
+	mosquitto_subscribe(mosq, NULL, TOPIC_PREFIX "ir_cut/set", 1);
+	mosquitto_subscribe(mosq, NULL, TOPIC_PREFIX "light_monitor/set", 1);
+	mosquitto_subscribe(mosq, NULL, TOPIC_PREFIX "mcu/sync_time", 1);
+	mosquitto_subscribe(mosq, NULL, TOPIC_PREFIX "mcu/motor_test", 1);
+	mosquitto_subscribe(mosq, NULL, TOPIC_PREFIX "schedule/refresh", 1);
+	mosquitto_subscribe(mosq, NULL, TOPIC_PREFIX "schedule/clear_all", 1);
+	mosquitto_subscribe(mosq, NULL, TOPIC_PREFIX "schedule/+/time/set", 1);
+	mosquitto_subscribe(mosq, NULL, TOPIC_PREFIX "schedule/+/weight/set", 1);
+	mosquitto_subscribe(mosq, NULL, TOPIC_PREFIX "schedule/+/enabled/set", 1);
+	if (cfg.main_led_gpio >= 0)
+		mosquitto_subscribe(mosq, NULL, TOPIC_PREFIX "led/set", 1);
+
+	publish_ha_discovery();
+
+	/* Kick off MCU queries */
+	mcu_get_version();
+	mcu_get_time();
+	request_full_schedule();
+}
+
+static void on_disconnect(struct mosquitto *mosq, void *ud, int rc)
+{
+	(void)mosq; (void)ud;
+	if (rc != 0)
+		log_err("catd: MQTT disconnected (rc=%d), reconnecting...\n", rc);
+}
+
+static void on_message(struct mosquitto *mosq, void *ud,
+		       const struct mosquitto_message *msg)
+{
+	(void)mosq; (void)ud;
+	if (!msg->payload || msg->payloadlen == 0) return;
+
+	char payload[256];
+	int len = msg->payloadlen;
+	if (len > (int)sizeof(payload) - 1) len = (int)sizeof(payload) - 1;
+	memcpy(payload, msg->payload, len);
+	payload[len] = '\0';
+
+	const char *t = msg->topic;
+
+	if      (!strcmp(t, TOPIC_PREFIX "feed/amount/set"))   handle_feed_amount(payload);
+	else if (!strcmp(t, TOPIC_PREFIX "feed/command"))      handle_feed_command(payload);
+	else if (!strcmp(t, TOPIC_PREFIX "ir_led/set"))        handle_ir_led_set(payload);
+	else if (!strcmp(t, TOPIC_PREFIX "ir_cut/set"))        handle_ir_cut_set(payload);
+	else if (!strcmp(t, TOPIC_PREFIX "light_monitor/set")) handle_light_monitor_set(payload);
+	else if (!strcmp(t, TOPIC_PREFIX "led/set"))           handle_main_led_set(payload);
+	else if (!strcmp(t, TOPIC_PREFIX "mcu/sync_time"))     handle_sync_time(payload);
+	else if (!strcmp(t, TOPIC_PREFIX "mcu/motor_test"))    handle_motor_test(payload);
+	else if (!strcmp(t, TOPIC_PREFIX "schedule/refresh"))  handle_refresh_schedule(payload);
+	else if (!strcmp(t, TOPIC_PREFIX "schedule/clear_all")) handle_clear_all_schedules(payload);
+	else {
+		/* schedule/<N>/<field>/set */
+		int slot = -1;
+		char field[16];
+		if (sscanf(t, TOPIC_PREFIX "schedule/%d/%15[^/]/set",
+			   &slot, field) == 2) {
+			handle_schedule_set(slot, field, payload);
+		}
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* MCU frame dispatch                                                  */
+/* ------------------------------------------------------------------ */
+
+static void on_frame(const struct mcu_frame *f)
+{
+	switch (f->cmd) {
+	case 0x01:
+		/* ACK echoes byte 12 of TX. payload = 0x00 (manual) or slot (auto). */
+		log_info("catd: feed ack (slot=%u)\n", f->payload[0]);
+		if (g_feed_pending) {
+			/* The cmd=0x07 result frame is what marks completion;
+			 * the ACK alone just confirms the command was received. */
+		}
+		break;
+
+	case 0x07:   /* feed complete — normal food-present path */
+	case 0x15: { /* feed complete — IR-beam food-present sensor path.
+		      * Same 10-byte payload layout as 0x07; this firmware
+		      * reports manual-feed completion here, so without it the
+		      * feed never clears and always "times out". */
+		struct mcu_feed_result r;
+		if (mcu_decode_feed_result(f, &r) == 0) {
+			log_info("catd: feed result cmd=0x%02x portions=%d weight=%d "
+				 "food_confirmed=%d feed_type=%d audio=%d\n",
+				 f->cmd, r.portions, r.weight, r.food_confirmed,
+				 r.feed_type, r.audio_index);
+			publish_feed_result(&r, f->raw, f->raw_len);
+			publish_feed_status("complete");
+			g_feed_pending = 0;
+		}
+		break;
+	}
+
+	case 0x05: {
+		/* Async error (mid-feed jam / motor fault). payload[0] is the
+		 * error code (0x04 observed on a low-food/obstructed feed). The
+		 * old code published the literal command byte "0x05" here,
+		 * discarding the real code. */
+		char code[8];
+		snprintf(code, sizeof(code), "0x%02x", f->payload[0]);
+		log_err("catd: MCU async error code %s\n", code);
+		mqtt_publish(TOPIC_PREFIX "feed/status", "error", 1);
+		mqtt_publish(TOPIC_PREFIX "feed/error_code", code, 1);
+		g_feed_pending = 0;
+		break;
+	}
+
+	case 0x0C:
+		/* Audio-state notification during scheduled feed; informational. */
+		log_info("catd: audio state 0x%02x\n", f->payload[0]);
+		break;
+
+	case 0x11: {
+		/* Chute-blocked sensor. The MCU emits FF FF 11 01 <state>
+		 * unsolicited whenever the chute switch toggles:
+		 *   payload 0x01 = blocked, 0x00 = clear.
+		 * It also fires this frame after a scheduled feed completes,
+		 * which makes sense as a "chute is clear of debris" check. */
+		int blocked = (f->payload[0] != 0);
+		if (blocked != g_chute_blocked) {
+			g_chute_blocked = blocked;
+			log_info("catd: chute %s\n", blocked ? "BLOCKED" : "clear");
+			mqtt_publish(TOPIC_PREFIX "chute/blocked",
+				     blocked ? "true" : "false", 1);
+		}
+		break;
+	}
+
+	case 0x09:
+	case 0x06: {
+		struct mcu_time t;
+		if (mcu_decode_time(f, &t) == 0) {
+			struct tm tm = {0};
+			tm.tm_year  = t.year - 1900;
+			tm.tm_mon   = t.month - 1;
+			tm.tm_mday  = t.day;
+			tm.tm_hour  = t.hour;
+			tm.tm_min   = t.minute;
+			tm.tm_sec   = t.second;
+			tm.tm_isdst = -1;
+			time_t mcu_unix = mktime(&tm);
+			int drift = (int)(time(NULL) - mcu_unix);
+			log_info("catd: MCU time %04d-%02d-%02d %02d:%02d:%02d (drift=%ds)\n",
+				 t.year, t.month, t.day, t.hour, t.minute, t.second, drift);
+			publish_mcu_time(mcu_unix, drift);
+			g_mcu_have_time = 1;
+		}
+		break;
+	}
+
+	case 0x0D: {
+		char ver[32];
+		if (mcu_decode_version(f, ver, sizeof(ver)) == 0) {
+			strncpy(g_mcu_version, ver, sizeof(g_mcu_version) - 1);
+			g_mcu_have_version = 1;
+			log_info("catd: MCU version: %s — publishing\n", g_mcu_version);
+			publish_mcu_version();
+		}
+		break;
+	}
+
+	case 0x02: {
+		struct mcu_slot s;
+		if (mcu_decode_slot(f, &s) == 0 &&
+		    s.slot_num >= 1 && s.slot_num <= NUM_MEAL_SLOTS) {
+			/* Convert MCU's raw weight (e.g. 20) to portions (1..10).
+			 * Round to nearest, clamp into the slider range so HA's
+			 * Number entity doesn't show out-of-range values. */
+			int portions = (s.weight + 5) / 10;
+			if (portions < 1)  portions = 1;
+			if (portions > 10) portions = 10;
+			s.weight = portions;
+			g_schedule[s.slot_num] = s;
+			publish_schedule_slot(s.slot_num);
+			state_save();
+			log_info("catd: schedule slot %d: %s %02d:%02d portions=%d en=%d\n",
+				 s.slot_num, slot_kind_str(s.kind),
+				 s.hour, s.minute, s.weight, s.enabled);
+		}
+		break;
+	}
+
+	case 0x0F:
+		log_info("catd: motor test result %02x %02x %02x\n",
+			 f->payload[0], f->payload[1], f->payload[2]);
+		break;
+
+	default: {
+		/* Frames the stock MCU emits that we don't decode yet:
+		 *   0x03 schedule-write echo, 0x08 command-class handshake,
+		 *   0x0B record-trigger, 0x18/0x19 sensor latches (battery / lid /
+		 *   button?). Dump full payload so these can be identified from
+		 *   logs on a live unit. */
+		char hex[3 * MCU_MAX_PAYLOAD + 1] = "";
+		int hp = 0;
+		for (int i = 0; i < f->len && i < MCU_MAX_PAYLOAD &&
+				hp < (int)sizeof(hex) - 3; i++)
+			hp += snprintf(hex + hp, sizeof(hex) - hp, "%02x ",
+				       f->payload[i]);
+		log_info("catd: unhandled frame sof1=0x%02x cmd=0x%02x len=%u payload=[ %s]\n",
+			 f->sof1, f->cmd, f->len, hex);
+		break;
+	}
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Periodic tasks                                                      */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Re-read the GPIOs that majestic also drives (IR LED + IR cut filter on
+ * its day/night transitions) so HA's switch state reflects reality. We
+ * only publish when the read value differs from our cached state.
+ */
+static void poll_gpio_states(void)
+{
+	int led = gpio_read(cfg.ir_led_gpio);
+	if (led >= 0 && led != g_ir_led_state) {
+		g_ir_led_state = led;
+		mqtt_publish(TOPIC_PREFIX "ir_led/state", led ? "ON" : "OFF", 1);
+		log_info("catd: IR LED changed externally → %s\n", led ? "ON" : "OFF");
+		state_save();
+	}
+
+	int cut = gpio_read(cfg.ir_cut_gpio);
+	if (cut >= 0 && cut != g_ir_cut_state) {
+		g_ir_cut_state = cut;
+		mqtt_publish(TOPIC_PREFIX "ir_cut/state", cut ? "ON" : "OFF", 1);
+		log_info("catd: IR cut changed externally → %s\n", cut ? "ON" : "OFF");
+		state_save();
+	}
+
+	if (cfg.main_led_gpio >= 0) {
+		int main_led = gpio_read(cfg.main_led_gpio);
+		if (main_led >= 0 && main_led != g_main_led_state) {
+			g_main_led_state = main_led;
+			mqtt_publish(TOPIC_PREFIX "led/state",
+				     main_led ? "ON" : "OFF", 1);
+			log_info("catd: main LED changed externally → %s\n",
+				 main_led ? "ON" : "OFF");
+			state_save();
+		}
+	}
+}
+
+static void periodic_tasks(void)
+{
+	time_t now = time(NULL);
+
+	poll_brightness();
+
+	/* Re-read GPIOs every 5 min so HA reflects majestic's day/night
+	 * transitions on the IR LED / IR cut filter. */
+	if (now - g_last_gpio_poll >= 300) {
+		poll_gpio_states();
+		g_last_gpio_poll = now;
+	}
+
+	/* Sync MCU clock every hour to bound long-term drift */
+	if (now - g_last_time_sync >= 3600) {
+		mcu_set_time_now();
+	}
+
+	/* Re-query MCU version/time every 30 s until we get them. The MCU
+	 * occasionally drops the first query if it's busy; this guarantees
+	 * the corresponding HA entities eventually populate. */
+	if ((!g_mcu_have_version || !g_mcu_have_time) &&
+	    now - g_last_mcu_query >= 30) {
+		if (!g_mcu_have_version) mcu_get_version();
+		if (!g_mcu_have_time)    mcu_get_time();
+		g_last_mcu_query = now;
+	}
+
+	/* Feed timeout */
+	if (g_feed_pending) {
+		int elapsed = (int)(now - g_feed_start);
+		int feed_timeout = 15 + g_feed_amount * 5;
+		if (elapsed >= feed_timeout) {
+			log_err("catd: feed timeout after %ds\n", elapsed);
+			publish_feed_status("timeout");
+			g_feed_pending = 0;
+		}
+	}
+}
+
+/* ------------------------------------------------------------------ */
+/* Signal handler                                                      */
+/* ------------------------------------------------------------------ */
+
+static void sig_handler(int sig)
+{
+	(void)sig;
+	g_running = 0;
+}
+
+static void usage(const char *prog)
+{
+	fprintf(stderr, "Usage: %s -c <config_file>\n", prog);
+	exit(1);
+}
+
+/* ------------------------------------------------------------------ */
+/* Main                                                                */
+/* ------------------------------------------------------------------ */
+
+int main(int argc, char **argv)
+{
+	const char *config_file = "/etc/catd.conf";
+
+	int opt;
+	while ((opt = getopt(argc, argv, "c:")) != -1) {
+		switch (opt) {
+		case 'c': config_file = optarg; break;
+		default:  usage(argv[0]);
+		}
+	}
+
+	openlog("catd", LOG_PID, LOG_DAEMON);
+
+	if (config_parse(config_file, &cfg) < 0) {
+		log_err("catd: failed to parse config %s\n", config_file);
+		return 1;
+	}
+
+	/* Apply timezone before any localtime()/mktime() call so MCU clock
+	 * pushes use wall-clock-of-record. OpenIPC defaults to UTC otherwise. */
+	if (cfg.timezone[0]) {
+		setenv("TZ", cfg.timezone, 1);
+		tzset();
+		log_info("catd: timezone set to %s\n", cfg.timezone);
+	}
+
+	resolve_media_urls(&cfg);
+
+	log_info("catd: device_id=%s broker=%s:%d uart=%s\n",
+		 cfg.device_id, cfg.broker_host, cfg.broker_port, cfg.uart_device);
+
+	signal(SIGINT, sig_handler);
+	signal(SIGTERM, sig_handler);
+
+	g_uart_fd = uart_open(cfg.uart_device);
+	if (g_uart_fd < 0) {
+		log_err("catd: failed to open UART %s\n", cfg.uart_device);
+		return 1;
+	}
+	log_info("catd: UART opened: %s\n", cfg.uart_device);
+
+	gpio_init_output(cfg.ir_led_gpio);
+	gpio_init_output(cfg.ir_cut_gpio);
+	if (cfg.main_led_gpio >= 0)
+		gpio_init_output(cfg.main_led_gpio);
+	log_info("catd: GPIO initialized: IR_LED=%d IR_CUT=%d LED=%d\n",
+		 cfg.ir_led_gpio, cfg.ir_cut_gpio, cfg.main_led_gpio);
+
+	/* Load saved state and restore the world to it. */
+	state_load();
+	gpio_write(cfg.ir_led_gpio, g_ir_led_state);
+	gpio_write(cfg.ir_cut_gpio, g_ir_cut_state);
+	if (cfg.main_led_gpio >= 0)
+		gpio_write(cfg.main_led_gpio, g_main_led_state);
+	mcu_push_saved_schedule();
+
+	mosquitto_lib_init();
+
+	g_mosq = mosquitto_new(cfg.device_id, true, NULL);
+	if (!g_mosq) {
+		log_err("catd: mosquitto_new failed\n");
+		return 1;
+	}
+
+	if (cfg.broker_user[0])
+		mosquitto_username_pw_set(g_mosq, cfg.broker_user,
+					 cfg.broker_pass[0] ? cfg.broker_pass : NULL);
+
+	mosquitto_will_set(g_mosq, TOPIC_PREFIX "status", 7, "offline", 1, true);
+
+	mosquitto_connect_callback_set(g_mosq, on_connect);
+	mosquitto_disconnect_callback_set(g_mosq, on_disconnect);
+	mosquitto_message_callback_set(g_mosq, on_message);
+
+	mosquitto_reconnect_delay_set(g_mosq, 5, 30, false);
+
+	int rc = mosquitto_connect(g_mosq, cfg.broker_host, cfg.broker_port, 60);
+	if (rc != MOSQ_ERR_SUCCESS) {
+		log_err("catd: MQTT connect to %s:%d failed: %s\n",
+			cfg.broker_host, cfg.broker_port, mosquitto_strerror(rc));
+	}
+
+	mosquitto_loop_start(g_mosq);
+
+	log_info("catd: entering main loop\n");
+
+	/* Push our time to the MCU on startup so subsequent schedules align */
+	mcu_set_time_now();
+
+	while (g_running) {
+		struct mcu_frame f;
+		int got = uart_recv_frame(g_uart_fd, &f, 5);
+
+		if (got == 1) {
+			on_frame(&f);
+		} else if (got < 0) {
+			/* parse error / drained noise — keep going */
+		}
+
+		periodic_tasks();
+	}
+
+	log_info("catd: shutting down\n");
+
+	mqtt_publish(TOPIC_PREFIX "status", "offline", 1);
+	usleep(200000);
+
+	/* Order matters: disconnect first so the network thread returns from its
+	 * socket wait. Calling mosquitto_loop_stop() first blocks forever trying
+	 * to join a thread that's still looping (or stuck in reconnect backoff) —
+	 * that deadlock is why SIGTERM didn't work and catd needed SIGKILL.
+	 * force=true cancels the thread if it's wedged mid-reconnect. */
+	mosquitto_disconnect(g_mosq);
+	mosquitto_loop_stop(g_mosq, true);
+	mosquitto_destroy(g_mosq);
+	mosquitto_lib_cleanup();
+
+	if (g_uart_fd >= 0) close(g_uart_fd);
+
+	gpio_cleanup(cfg.ir_led_gpio);
+	gpio_cleanup(cfg.ir_cut_gpio);
+	if (cfg.main_led_gpio >= 0)
+		gpio_cleanup(cfg.main_led_gpio);
+
+	closelog();
+	return 0;
+}
diff --git a/general/package/catd/src/gpio.c b/general/package/catd/src/gpio.c
new file mode 100644
index 00000000..0ff51a33
--- /dev/null
+++ b/general/package/catd/src/gpio.c
@@ -0,0 +1,72 @@
+#include "gpio.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+static int write_file(const char *path, const char *val)
+{
+	int fd = open(path, O_WRONLY);
+	if (fd < 0) {
+		/* EBUSY on export means already exported — not an error */
+		if (errno == EBUSY)
+			return 0;
+		perror(path);
+		return -1;
+	}
+	ssize_t n = write(fd, val, strlen(val));
+	close(fd);
+	return (n < 0) ? -1 : 0;
+}
+
+int gpio_init_output(int gpio_num)
+{
+	char buf[64];
+
+	/* Export */
+	snprintf(buf, sizeof(buf), "%d", gpio_num);
+	write_file("/sys/class/gpio/export", buf);
+
+	/* Allow sysfs files to settle */
+	usleep(50000);
+
+	/* Direction */
+	snprintf(buf, sizeof(buf), "/sys/class/gpio/gpio%d/direction", gpio_num);
+	if (write_file(buf, "out") < 0)
+		return -1;
+
+	return 0;
+}
+
+int gpio_write(int gpio_num, int value)
+{
+	char path[64];
+	snprintf(path, sizeof(path), "/sys/class/gpio/gpio%d/value", gpio_num);
+	return write_file(path, value ? "1" : "0");
+}
+
+int gpio_read(int gpio_num)
+{
+	char path[64];
+	snprintf(path, sizeof(path), "/sys/class/gpio/gpio%d/value", gpio_num);
+
+	int fd = open(path, O_RDONLY);
+	if (fd < 0) {
+		perror(path);
+		return -1;
+	}
+
+	char c = '0';
+	read(fd, &c, 1);
+	close(fd);
+	return (c == '1') ? 1 : 0;
+}
+
+void gpio_cleanup(int gpio_num)
+{
+	char buf[16];
+	snprintf(buf, sizeof(buf), "%d", gpio_num);
+	write_file("/sys/class/gpio/unexport", buf);
+}
diff --git a/general/package/catd/src/gpio.h b/general/package/catd/src/gpio.h
new file mode 100644
index 00000000..dc8d5fd6
--- /dev/null
+++ b/general/package/catd/src/gpio.h
@@ -0,0 +1,16 @@
+#ifndef CATD_GPIO_H
+#define CATD_GPIO_H
+
+/* Export a GPIO pin and set it as output. Returns 0 on success. */
+int gpio_init_output(int gpio_num);
+
+/* Write value (0 or 1) to an exported GPIO. Returns 0 on success. */
+int gpio_write(int gpio_num, int value);
+
+/* Read current value from an exported GPIO. Returns 0/1 or -1 on error. */
+int gpio_read(int gpio_num);
+
+/* Unexport a GPIO pin. */
+void gpio_cleanup(int gpio_num);
+
+#endif
diff --git a/general/package/catd/src/test_uart.c b/general/package/catd/src/test_uart.c
new file mode 100644
index 00000000..da3a015c
--- /dev/null
+++ b/general/package/catd/src/test_uart.c
@@ -0,0 +1,160 @@
+/*
+ * Host-side unit tests for the MCU frame decoders in uart.c.
+ *
+ * Built and run on the host (not cross-compiled). Exercises the pure
+ * decode functions against real wire captures from the device.
+ *
+ *   cc -DUART_TEST -o test_uart test_uart.c uart.c && ./test_uart
+ *
+ * The feed-result cases use the exact bytes captured on ttyAMA2 during a
+ * 1-portion manual feed:
+ *   normal:        ff fc 07 0a 00 00 00 00 00 0a 00 21 00 00
+ *   IR-confirmed:  ff fc 15 0a 00 00 00 00 00 0a 00 21 00 00
+ * Disassembly of libjiake_protocol.so pthread_main (0xdb6c handler) shows the
+ * dispensed weight is a little-endian uint16 at payload[5..6] (== 0x000a = 10
+ * == 1 portion), NOT payload[7] (== 0x21, a feed_type<<4 | slot status byte).
+ */
+
+#include "uart.h"
+
+#include <signal.h>
+#include <stdio.h>
+#include <string.h>
+
+/* uart.c references this; provide a definition for the test link. */
+volatile sig_atomic_t g_running = 1;
+
+static int g_fail;
+
+#define CHECK(cond, ...) do {                                   \
+	if (!(cond)) {                                          \
+		printf("FAIL %s:%d: ", __func__, __LINE__);    \
+		printf(__VA_ARGS__);                            \
+		printf("\n");                                  \
+		g_fail++;                                      \
+	}                                                      \
+} while (0)
+
+/* Build an mcu_frame from raw on-the-wire bytes (incl. FF + SOF1 + cmd + len). */
+static struct mcu_frame frame_from_wire(const uint8_t *raw, int n)
+{
+	struct mcu_frame f;
+	memset(&f, 0, sizeof(f));
+	f.sof1 = raw[1];
+	f.cmd  = raw[2];
+	f.len  = raw[3];
+	memcpy(f.raw, raw, n);
+	f.raw_len = n;
+	if (f.len > 0 && f.len <= MCU_MAX_PAYLOAD)
+		memcpy(f.payload, raw + 4, f.len);
+	return f;
+}
+
+static void test_feed_result_normal(void)
+{
+	const uint8_t wire[] = {
+		0xff, 0xfc, 0x07, 0x0a,
+		0x00, 0x00, 0x00, 0x00, 0x00, 0x0a, 0x00, 0x21, 0x00, 0x00
+	};
+	struct mcu_frame f = frame_from_wire(wire, sizeof(wire));
+
+	struct mcu_feed_result r;
+	int rc = mcu_decode_feed_result(&f, &r);
+	CHECK(rc == 0, "decode rc=%d, want 0", rc);
+	CHECK(r.weight == 10, "weight=%d, want 10 (LE16 payload[5..6])", r.weight);
+	CHECK(r.portions == 1, "portions=%d, want 1 (weight/10)", r.portions);
+	CHECK(r.feed_type == 2, "feed_type=%d, want 2 (payload[7]>>4)", r.feed_type);
+	CHECK(r.slot == 0, "slot=%d, want 0 (payload[7]&0x0E)", r.slot);
+	CHECK(r.audio_index == 0, "audio_index=%d, want 0 (payload[9])", r.audio_index);
+	CHECK(r.food_confirmed == 0, "food_confirmed=%d, want 0 (cmd!=0x15)",
+	      r.food_confirmed);
+}
+
+static void test_feed_result_ir_confirmed(void)
+{
+	const uint8_t wire[] = {
+		0xff, 0xfc, 0x15, 0x0a,
+		0x00, 0x00, 0x00, 0x00, 0x00, 0x0a, 0x00, 0x21, 0x00, 0x00
+	};
+	struct mcu_frame f = frame_from_wire(wire, sizeof(wire));
+
+	struct mcu_feed_result r;
+	int rc = mcu_decode_feed_result(&f, &r);
+	CHECK(rc == 0, "decode rc=%d, want 0", rc);
+	CHECK(r.weight == 10, "weight=%d, want 10", r.weight);
+	CHECK(r.portions == 1, "portions=%d, want 1", r.portions);
+	CHECK(r.food_confirmed == 1, "food_confirmed=%d, want 1 (cmd==0x15)",
+	      r.food_confirmed);
+}
+
+/* A 3-portion feed must report weight 30 (LE16), portions 3. */
+static void test_feed_result_three_portions(void)
+{
+	const uint8_t wire[] = {
+		0xff, 0xfc, 0x07, 0x0a,
+		0x00, 0x00, 0x00, 0x00, 0x00, 0x1e, 0x00, 0x21, 0x00, 0x00
+	};
+	struct mcu_frame f = frame_from_wire(wire, sizeof(wire));
+
+	struct mcu_feed_result r;
+	int rc = mcu_decode_feed_result(&f, &r);
+	CHECK(rc == 0, "decode rc=%d, want 0", rc);
+	CHECK(r.weight == 30, "weight=%d, want 30", r.weight);
+	CHECK(r.portions == 3, "portions=%d, want 3", r.portions);
+}
+
+/* Multi-portion feed exercising the high byte of the LE16 weight. */
+static void test_feed_result_weight_high_byte(void)
+{
+	/* weight = 0x0102 = 258 -> portions 25 */
+	const uint8_t wire[] = {
+		0xff, 0xfc, 0x07, 0x0a,
+		0x00, 0x00, 0x00, 0x00, 0x00, 0x02, 0x01, 0x21, 0x00, 0x00
+	};
+	struct mcu_frame f = frame_from_wire(wire, sizeof(wire));
+	struct mcu_feed_result r;
+	CHECK(mcu_decode_feed_result(&f, &r) == 0, "decode failed");
+	CHECK(r.weight == 0x0102, "weight=%d, want 258 (LE16)", r.weight);
+}
+
+static void test_feed_result_rejects_other_cmds(void)
+{
+	const uint8_t wire[] = { 0xff, 0xff, 0x11, 0x01, 0x01 };
+	struct mcu_frame f = frame_from_wire(wire, sizeof(wire));
+	struct mcu_feed_result r;
+	CHECK(mcu_decode_feed_result(&f, &r) == -1,
+	      "should reject cmd=0x11 chute frame");
+}
+
+static void test_time_decode(void)
+{
+	/* ff ff 06 06 <yr-1960> <mon> <day> <hh> <mm> <ss> -> 2026-06-17 12:30:05 */
+	const uint8_t wire[] = {
+		0xff, 0xff, 0x06, 0x06, 66, 6, 17, 12, 30, 5
+	};
+	struct mcu_frame f = frame_from_wire(wire, sizeof(wire));
+	struct mcu_time t;
+	int rc = mcu_decode_time(&f, &t);
+	CHECK(rc == 0, "time rc=%d", rc);
+	CHECK(t.year == 2026, "year=%d want 2026", t.year);
+	CHECK(t.month == 6 && t.day == 17, "date=%d-%d", t.month, t.day);
+	CHECK(t.hour == 12 && t.minute == 30 && t.second == 5,
+	      "tod=%d:%d:%d", t.hour, t.minute, t.second);
+}
+
+int main(void)
+{
+	test_feed_result_normal();
+	test_feed_result_ir_confirmed();
+	test_feed_result_three_portions();
+	test_feed_result_weight_high_byte();
+	test_feed_result_rejects_other_cmds();
+	test_time_decode();
+
+	if (g_fail) {
+		printf("\n%d check(s) FAILED\n", g_fail);
+		return 1;
+	}
+	printf("all decoder tests passed\n");
+	return 0;
+}
diff --git a/general/package/catd/src/uart.c b/general/package/catd/src/uart.c
new file mode 100644
index 00000000..a53ec35c
--- /dev/null
+++ b/general/package/catd/src/uart.c
@@ -0,0 +1,352 @@
+/*
+ * MCU UART protocol implementation.
+ * See docs/MCU_PROTOCOL.md for the wire format.
+ */
+
+#include "uart.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/select.h>
+#include <termios.h>
+#include <time.h>
+#include <unistd.h>
+
+extern volatile sig_atomic_t g_running;
+
+/* ------------------------------------------------------------------ */
+/* Port management                                                     */
+/* ------------------------------------------------------------------ */
+
+int uart_open(const char *device)
+{
+	int fd = open(device, O_RDWR | O_NOCTTY | O_NDELAY);
+	if (fd < 0) {
+		perror("uart: open");
+		return -1;
+	}
+	fcntl(fd, F_SETFL, 0); /* blocking */
+
+	struct termios tio;
+	tcgetattr(fd, &tio);
+
+	cfsetispeed(&tio, B115200);
+	cfsetospeed(&tio, B115200);
+
+	tio.c_cflag |= (CLOCAL | CREAD);
+	tio.c_cflag &= ~PARENB;
+	tio.c_cflag &= ~CSTOPB;
+	tio.c_cflag &= ~CSIZE;
+	tio.c_cflag |= CS8;
+
+	tio.c_lflag &= ~(ICANON | ECHO | ECHOE | ISIG);
+	tio.c_iflag &= ~(IXON | IXOFF | IXANY);
+	tio.c_oflag &= ~OPOST;
+
+	/* min=0 vtime=5 (0.5s inter-byte). Reads return whatever's available. */
+	tio.c_cc[VMIN]  = 0;
+	tio.c_cc[VTIME] = 5;
+
+	tcflush(fd, TCIFLUSH);
+	tcsetattr(fd, TCSANOW, &tio);
+
+	return fd;
+}
+
+/* ------------------------------------------------------------------ */
+/* Internal: blocking I/O with timeout                                 */
+/* ------------------------------------------------------------------ */
+
+static int wait_readable(int fd, int timeout_s)
+{
+	time_t deadline = time(NULL) + timeout_s;
+	int ret;
+
+	for (;;) {
+		int remaining = (int)(deadline - time(NULL));
+		if (remaining < 0)
+			remaining = 0;
+
+		fd_set rfds;
+		FD_ZERO(&rfds);
+		FD_SET(fd, &rfds);
+
+		struct timeval tv;
+		tv.tv_sec  = remaining;
+		tv.tv_usec = 0;
+
+		ret = select(fd + 1, &rfds, NULL, NULL, &tv);
+		if (ret >= 0 || errno != EINTR)
+			break;
+		if (!g_running)
+			return -1;
+	}
+	if (ret < 0)
+		perror("uart: select");
+	return ret;
+}
+
+static int read_bytes(int fd, uint8_t *buf, int n, int timeout_s)
+{
+	int total = 0;
+	time_t deadline = time(NULL) + timeout_s;
+
+	while (total < n) {
+		int remaining = (int)(deadline - time(NULL));
+		if (remaining <= 0)
+			break;
+
+		if (wait_readable(fd, remaining) <= 0)
+			break;
+
+		ssize_t r = read(fd, buf + total, n - total);
+		if (r > 0)
+			total += (int)r;
+		else if (r == 0)
+			break;
+		else if (errno != EINTR)
+			break;
+	}
+	return total;
+}
+
+static int write_all(int fd, const uint8_t *buf, int n)
+{
+	ssize_t w = write(fd, buf, n);
+	if (w != n) {
+		perror("uart: write");
+		return -1;
+	}
+	tcdrain(fd);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* TX commands                                                         */
+/* ------------------------------------------------------------------ */
+
+int uart_send_manual_feed(int fd, uint8_t weight)
+{
+	uint8_t pkt[14] = {
+		0xFF, 0xFF, 0x01, 0x0A,
+		0x3A, 0x09, 0x03, 0x0E, 0x0B,
+		weight,
+		0x00, 0x00, 0x00, 0x0A
+	};
+	return write_all(fd, pkt, sizeof(pkt));
+}
+
+int uart_send_auto_feed(int fd, int hour, int minute, int weight,
+			int audio_idx, int slot, int enabled)
+{
+	uint8_t pkt[14] = {
+		0xFF, 0xFF, 0x01, 0x0A,
+		0xA5, 0xA7, 0x7F,
+		(uint8_t)(hour & 0xFF),
+		(uint8_t)(minute & 0xFF),
+		(uint8_t)(weight & 0xFF),
+		(uint8_t)((weight >> 8) & 0xFF),
+		(uint8_t)(enabled ? 0x11 : 0x10),
+		(uint8_t)(slot & 0xFF),
+		(uint8_t)(audio_idx & 0xFF)
+	};
+	return write_all(fd, pkt, sizeof(pkt));
+}
+
+int uart_send_set_time(int fd, time_t when)
+{
+	struct tm tm;
+	localtime_r(&when, &tm);
+
+	uint8_t pkt[10] = {
+		0xFF, 0xFF, 0x06, 0x06,
+		(uint8_t)((tm.tm_year + 1900 - 1960) & 0xFF),  /* year - 1960 */
+		(uint8_t)((tm.tm_mon + 1) & 0xFF),             /* month 1..12 */
+		(uint8_t)(tm.tm_mday & 0xFF),
+		(uint8_t)(tm.tm_hour & 0xFF),
+		(uint8_t)(tm.tm_min & 0xFF),
+		(uint8_t)(tm.tm_sec & 0xFF)
+	};
+	return write_all(fd, pkt, sizeof(pkt));
+}
+
+int uart_send_get_time(int fd)
+{
+	uint8_t pkt[4] = { 0xFF, 0xFF, 0x09, 0x00 };
+	return write_all(fd, pkt, sizeof(pkt));
+}
+
+int uart_send_get_version(int fd)
+{
+	uint8_t pkt[4] = { 0xFF, 0xFF, 0x0D, 0x00 };
+	return write_all(fd, pkt, sizeof(pkt));
+}
+
+int uart_send_motor_test(int fd)
+{
+	uint8_t pkt[4] = { 0xFF, 0xFF, 0x0F, 0x00 };
+	return write_all(fd, pkt, sizeof(pkt));
+}
+
+int uart_send_read_schedule(int fd, int slot)
+{
+	uint8_t pkt[5] = { 0xFF, 0xFF, 0x02, 0x01, (uint8_t)(slot & 0xFF) };
+	return write_all(fd, pkt, sizeof(pkt));
+}
+
+/* ------------------------------------------------------------------ */
+/* RX framing                                                          */
+/* ------------------------------------------------------------------ */
+
+int uart_recv_frame(int fd, struct mcu_frame *out, int timeout_s)
+{
+	memset(out, 0, sizeof(*out));
+
+	time_t deadline = time(NULL) + timeout_s;
+
+	/* Hunt for SOF (FF + byte >= FC). Single-byte reads to resync on noise. */
+	uint8_t b = 0, prev = 0;
+	int have_prev = 0;
+	for (;;) {
+		int remaining = (int)(deadline - time(NULL));
+		if (remaining <= 0)
+			return 0;
+		if (wait_readable(fd, remaining) <= 0)
+			return 0;
+		if (read_bytes(fd, &b, 1, 1) != 1)
+			return 0;
+
+		if (have_prev && prev == 0xFF && b >= 0xFC) {
+			/* Found SOF */
+			out->raw[0] = 0xFF;
+			out->raw[1] = b;
+			out->raw_len = 2;
+			out->sof1 = b;
+			break;
+		}
+		prev = b;
+		have_prev = 1;
+	}
+
+	/* Read CMD + LEN */
+	uint8_t hdr[2];
+	if (read_bytes(fd, hdr, 2, 2) != 2)
+		return 0;
+	out->cmd = hdr[0];
+	out->len = hdr[1];
+	out->raw[2] = hdr[0];
+	out->raw[3] = hdr[1];
+	out->raw_len = 4;
+
+	if (out->len > MCU_MAX_PAYLOAD)
+		return -1;
+
+	if (out->len > 0) {
+		int got = read_bytes(fd, out->payload, out->len, 5);
+		if (got <= 0)
+			return 0;
+		memcpy(out->raw + 4, out->payload, got);
+		out->raw_len = 4 + got;
+		if (got != out->len)
+			return -1;
+	}
+
+	return 1;
+}
+
+/* ------------------------------------------------------------------ */
+/* Frame decoders                                                      */
+/* ------------------------------------------------------------------ */
+
+int mcu_decode_time(const struct mcu_frame *f, struct mcu_time *out)
+{
+	if ((f->cmd != 0x09 && f->cmd != 0x06) || f->len != 6)
+		return -1;
+	out->year   = (int)f->payload[0] + 1960;
+	out->month  = f->payload[1];
+	out->day    = f->payload[2];
+	out->hour   = f->payload[3];
+	out->minute = f->payload[4];
+	out->second = f->payload[5];
+	return 0;
+}
+
+int mcu_decode_slot(const struct mcu_frame *f, struct mcu_slot *out)
+{
+	if (f->cmd != 0x02 || f->len != 10)
+		return -1;
+
+	memset(out, 0, sizeof(*out));
+
+	const uint8_t *p = f->payload;
+
+	/* Auto-feed slot: A5 A7 7F HH MM WL WH EN SLOT AUDIO */
+	if (p[0] == 0xA5 && p[1] == 0xA7 && p[2] == 0x7F) {
+		out->kind      = MCU_SLOT_AUTOFEED;
+		out->hour      = p[3];
+		out->minute    = p[4];
+		out->weight    = p[5] | (p[6] << 8);
+		out->enabled   = (p[7] & 0x01) ? 1 : 0;  /* low bit of byte 11 */
+		out->slot_num  = p[8];
+		out->audio_idx = p[9];
+		return 0;
+	}
+
+	/* Recurring meal slot: 12 01 01 HH MM WL 00 EN MEAL_NUM 00 */
+	if (p[0] == 0x12 && p[1] == 0x01 && p[2] == 0x01) {
+		out->kind     = MCU_SLOT_MEAL;
+		out->hour     = p[3];
+		out->minute   = p[4];
+		out->weight   = p[5];
+		out->enabled  = (p[7] & 0x01) ? 1 : 0;
+		out->slot_num = p[8];
+		return 0;
+	}
+
+	/* Anything else: treat as empty/unrecognized. */
+	out->kind = MCU_SLOT_EMPTY;
+	return 0;
+}
+
+int mcu_decode_feed_result(const struct mcu_frame *f, struct mcu_feed_result *out)
+{
+	if ((f->cmd != 0x07 && f->cmd != 0x15) || f->len < 10)
+		return -1;
+	if (!out)
+		return 0;
+
+	/*
+	 * Layout per libjiake_protocol.so pthread_main (0xdb6c handler):
+	 *   weight = payload[5] | (payload[6] << 8)   -- the value the stock
+	 *            firmware forwards to its cloud as "weight" (dc28/dc24/dc30:
+	 *            orr r6, p5, p6, lsl #8). This is MCU units = portions * 10.
+	 *   payload[7] is a packed status byte (NOT a weight): high nibble is the
+	 *            firmware's feed_type/completion seed, low nibble & 0x0E is the
+	 *            schedule-slot / mem_id index.
+	 *   payload[9] is the echoed audio-clip index.
+	 * The previous code read payload[7] as a weight, which yielded e.g.
+	 * 0x21 = 33 ("3 portions") for a real 1-portion feed.
+	 */
+	out->weight        = f->payload[5] | (f->payload[6] << 8);
+	out->portions      = out->weight / 10;
+	out->feed_type     = f->payload[7] >> 4;
+	out->slot          = f->payload[7] & 0x0E;
+	out->audio_index   = f->payload[9];
+	out->food_confirmed = (f->cmd == 0x15) ? 1 : 0;
+	return 0;
+}
+
+int mcu_decode_version(const struct mcu_frame *f, char *out, size_t out_sz)
+{
+	if (f->cmd != 0x0D || f->len == 0 || out_sz == 0)
+		return -1;
+	size_t n = f->len;
+	if (n > out_sz - 1)
+		n = out_sz - 1;
+	memcpy(out, f->payload, n);
+	out[n] = '\0';
+	return 0;
+}
diff --git a/general/package/catd/src/uart.h b/general/package/catd/src/uart.h
new file mode 100644
index 00000000..99aa7d05
--- /dev/null
+++ b/general/package/catd/src/uart.h
@@ -0,0 +1,149 @@
+#ifndef CATD_UART_H
+#define CATD_UART_H
+
+#include <stdint.h>
+#include <time.h>
+
+/*
+ * Wire protocol per docs/MCU_PROTOCOL.md.
+ *
+ * All frames: FF FX <cmd> <len> <payload...>  where SOF1 is FC..FF and
+ * the total frame size is len+4.
+ */
+
+#define MCU_MAX_PAYLOAD 20  /* host RX buffer cap is 24 bytes total */
+
+/* RX frame parsed from the wire. */
+struct mcu_frame {
+	uint8_t  sof1;                          /* second SOF byte (FC..FF) */
+	uint8_t  cmd;
+	uint8_t  len;
+	uint8_t  payload[MCU_MAX_PAYLOAD];
+	uint8_t  raw[MCU_MAX_PAYLOAD + 4];      /* full frame including SOF/cmd/len */
+	int      raw_len;
+};
+
+/* Decoded MCU clock from cmd=0x09 / 0x06 frames. */
+struct mcu_time {
+	int year;     /* full year (e.g. 2026) */
+	int month;    /* 1..12 */
+	int day;      /* 1..31 */
+	int hour;     /* 0..23 */
+	int minute;   /* 0..59 */
+	int second;   /* 0..59 */
+};
+
+/* Decoded schedule slot record from cmd=0x02 read response. */
+enum mcu_slot_kind {
+	MCU_SLOT_EMPTY = 0,        /* uninitialized / disabled / unrecognized */
+	MCU_SLOT_AUTOFEED,         /* one-shot auto-feed (A5 A7 7F marker) */
+	MCU_SLOT_MEAL,             /* recurring meal slot (12 01 01 marker) */
+};
+
+struct mcu_slot {
+	enum mcu_slot_kind kind;
+	int     slot_num;          /* 1..8 */
+	int     hour;              /* 0..23 */
+	int     minute;            /* 0..59 */
+	int     weight;            /* 0..65535 (LE16 for autofeed; uint8 for meal) */
+	int     enabled;           /* 1 if low bit of enable byte is set */
+	int     audio_idx;         /* autofeed only */
+};
+
+/*
+ * Decoded feed-complete record from a cmd=0x07 / 0x15 frame.
+ *
+ * Field offsets were recovered from libjiake_protocol.so pthread_main (the
+ * stock firmware's RX handler at 0xdb6c) and confirmed against live captures:
+ *   normal:       ff fc 07 0a 00 00 00 00 00 0a 00 21 00 00
+ *   IR-confirmed: ff fc 15 0a 00 00 00 00 00 0a 00 21 00 00
+ * The stock firmware reports a *manual* feed's completion as cmd=0x15 (IR
+ * food-present), so both cmds share one handler and one payload layout.
+ *
+ * Note: this hardware has NO load cell. "weight" is the commanded/echoed feed
+ * amount in MCU units (portions * 10), not a measured dispense.
+ */
+struct mcu_feed_result {
+	int weight;         /* LE16 payload[5..6], MCU units (portions*10)        */
+	int portions;       /* weight / 10 (one_feed_weight = 10)                 */
+	int feed_type;      /* payload[7] >> 4 (firmware completion-type nibble)  */
+	int slot;           /* payload[7] & 0x0E (mem_id / schedule slot index)   */
+	int audio_index;    /* payload[9] (echoed sound-clip index, 0 = silent)   */
+	int food_confirmed; /* 1 if cmd==0x15 (hopper IR beam saw food fall)      */
+};
+
+/* ------------------------------------------------------------------ */
+/* Port management                                                     */
+/* ------------------------------------------------------------------ */
+
+/* Open and configure UART at 115200 8N1 raw mode. Returns fd or -1. */
+int uart_open(const char *device);
+
+/* ------------------------------------------------------------------ */
+/* TX commands — all return 0 on success, -1 on write error            */
+/* ------------------------------------------------------------------ */
+
+/* Manual one-shot feed at given weight (10..255). */
+int uart_send_manual_feed(int fd, uint8_t weight);
+
+/*
+ * Schedule a daily-recurring auto-feed for HH:MM in the MCU's clock frame.
+ * Fires every day at HH:MM until the slot is overwritten or disabled.
+ * - weight: minimum 10; values <10 cause MCU red error LED at fire.
+ * - audio_idx: 0 = silent. Non-zero references a preloaded sound file.
+ * - slot: 1..6 — must be non-zero or the MCU silently rejects.
+ * - enabled: 1 = active (byte 11 = 0x11), 0 = disabled (byte 11 = 0x10).
+ * The schedule replaces whatever was in `slot` previously.
+ */
+int uart_send_auto_feed(int fd, int hour, int minute, int weight,
+			int audio_idx, int slot, int enabled);
+
+/* Set MCU clock from a host time_t (uses localtime()). */
+int uart_send_set_time(int fd, time_t when);
+
+/* Query MCU time (response: cmd=0x09). */
+int uart_send_get_time(int fd);
+
+/* Query MCU firmware version (response: cmd=0x0D, ASCII). */
+int uart_send_get_version(int fd);
+
+/* Trigger MCU motor self-test (response: cmd=0x0F). */
+int uart_send_motor_test(int fd);
+
+/*
+ * Read a schedule slot.
+ * slot=0 → "dump all" (MCU emits one cmd=0x02 frame per slot).
+ * slot=1..8 → just that slot.
+ */
+int uart_send_read_schedule(int fd, int slot);
+
+/* ------------------------------------------------------------------ */
+/* RX                                                                  */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Receive one frame with a per-call timeout (seconds).
+ * Returns 1 on a parsed frame, 0 on timeout, -1 on error.
+ *
+ * Resyncs on noise: hunts for SOF (FF + byte >= FC), validates LEN,
+ * accumulates LEN bytes of payload.
+ */
+int uart_recv_frame(int fd, struct mcu_frame *out, int timeout_s);
+
+/* ------------------------------------------------------------------ */
+/* Frame decoders — return 0 on success, -1 if frame doesn't match     */
+/* ------------------------------------------------------------------ */
+
+/* Decode a cmd=0x09 (or cmd=0x06) time frame into mcu_time. */
+int mcu_decode_time(const struct mcu_frame *f, struct mcu_time *out);
+
+/* Decode a cmd=0x02 schedule-slot read response into mcu_slot. */
+int mcu_decode_slot(const struct mcu_frame *f, struct mcu_slot *out);
+
+/* Decode a cmd=0x07/0x15 feed-complete frame into *out. Returns 0 on success. */
+int mcu_decode_feed_result(const struct mcu_frame *f, struct mcu_feed_result *out);
+
+/* Decode a cmd=0x0D firmware version string; null-terminates into out[]. */
+int mcu_decode_version(const struct mcu_frame *f, char *out, size_t out_sz);
+
+#endif
