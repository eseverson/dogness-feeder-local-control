+		CC="$(TARGET_CC)" \
+		CFLAGS="$(TARGET_CFLAGS) -Wall -Wextra -std=c99 -pedantic -D_POSIX_C_SOURCE=200809L -D_DEFAULT_SOURCE" \
+		LDFLAGS="$(TARGET_LDFLAGS) -lmosquitto -lpthread" \
+		-C $(@D)
+endef
