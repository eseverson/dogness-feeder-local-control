diff --git a/general/package/catd/src/catd.c b/general/package/catd/src/catd.c
new file mode 100644
index 00000000..eb5af8ff
--- /dev/null
+++ b/general/package/catd/src/catd.c
@@ -0,0 +1,1767 @@
+/*
+ * catd — MQTT bridge daemon for Dogness cat feeder
+ *
+ * Bridges the MCU UART protocol (manual + scheduled feeds, schedule slots,
+ * MCU clock, motor test, firmware version) and GPIO controls (IR LED, IR
+ * cut filter) to an MQTT broker using the homeassistant/cat/ topic
+ * namespace, with HA MQTT-discovery so entities appear automatically.
+ */
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <ifaddrs.h>
+#include <net/if.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <syslog.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <mosquitto.h>
+
+#include "gpio.h"
+#include "uart.h"
+
+#define TOPIC_PREFIX "homeassistant/cat/"
+
+/* ------------------------------------------------------------------ */
+/* Configuration                                                       */
+/* ------------------------------------------------------------------ */
+
+struct config {
+	char broker_host[128];
+	int  broker_port;
+	char broker_user[128];
+	char broker_pass[128];
+	char device_id[64];
+	char uart_device[64];
+	int  ir_led_gpio;
+	int  ir_cut_gpio;
+	int  main_led_gpio;
+	char stream_url[256];
+	char snapshot_url[256];
+	char audio_url[256];
+	char play_audio_url[256];
+	char state_file[128];   /* persisted state path (key=value file) */
+	char timezone[64];      /* POSIX TZ string (e.g. "PST8PDT,M3.2.0,M11.1.0"); empty = inherit env */
+};
+
+static struct config cfg = {
+	.broker_host    = "192.168.1.2",
+	.broker_port    = 1883,
+	.device_id      = "feeder-1",
+	.uart_device    = "/dev/ttyAMA2",
+	.ir_led_gpio    = 0,
+	.ir_cut_gpio    = 37,
+	.main_led_gpio  = 2,
+	.state_file     = "/etc/catd.state",
+};
+
+/* ------------------------------------------------------------------ */
+/* Global state                                                        */
+/* ------------------------------------------------------------------ */
+
+#define NUM_MEAL_SLOTS 6   /* user-visible meal slots (Breakfast..SixthMeal) */
+
+volatile sig_atomic_t g_running = 1;
+static struct mosquitto *g_mosq;
+static int g_uart_fd = -1;
+static pthread_mutex_t g_uart_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* Feed state */
+static volatile int g_feed_pending;
+static int g_feed_amount = 1;        /* slider value, 1..10 (×10 = MCU weight) */
+static time_t g_feed_start;
+
+/* GPIO/light states */
+static int g_ir_led_state;
+static int g_ir_cut_state;
+static int g_main_led_state;
+static int g_light_monitor_state;
+
+/* Periodic-poll bookkeeping */
+static time_t g_last_brightness;
+static time_t g_last_time_sync;
+static time_t g_last_mcu_query;   /* re-query MCU version/time if we never got a response */
+static time_t g_last_gpio_poll;   /* re-read IR LED / IR cut so HA stays in sync with majestic */
+
+/* MCU info */
+static char  g_mcu_version[32];
+static int   g_mcu_have_version;
+static int   g_mcu_have_time;
+static int   g_chute_blocked = -1;   /* -1 = unknown until first cmd=0x11 frame */
+
+/* Cached schedule (slots 1..NUM_MEAL_SLOTS). We read these periodically
+ * and on demand; the structs always reflect what the MCU last reported. */
+static struct mcu_slot g_schedule[NUM_MEAL_SLOTS + 1]; /* 1-indexed */
+
+/* Forward declarations */
+static void mqtt_publish(const char *topic, const char *payload, int retain);
+static void publish_schedule_slot(int slot);
+static void publish_mcu_version(void);
+static void publish_mcu_time(time_t mcu_unix, int drift_sec);
+static void request_full_schedule(void);
+
+/* ------------------------------------------------------------------ */
+/* Logging                                                             */
+/* ------------------------------------------------------------------ */
+
+static void log_info(const char *fmt, ...)
+{
+	va_list ap;
+	va_start(ap, fmt);
+	vprintf(fmt, ap);
+	va_end(ap);
+	fflush(stdout);
+
+	char buf[512];
+	va_start(ap, fmt);
+	vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	syslog(LOG_INFO, "%s", buf);
+}
+
+static void log_err(const char *fmt, ...)
+{
+	va_list ap;
+	va_start(ap, fmt);
+	vfprintf(stderr, fmt, ap);
+	va_end(ap);
+
+	char buf[512];
+	va_start(ap, fmt);
+	vsnprintf(buf, sizeof(buf), fmt, ap);
+	va_end(ap);
+	syslog(LOG_ERR, "%s", buf);
+}
+
+/* ------------------------------------------------------------------ */
+/* Config parser                                                       */
+/* ------------------------------------------------------------------ */
+
+static char *trim(char *s)
+{
+	while (*s == ' ' || *s == '\t') s++;
+	char *end = s + strlen(s) - 1;
+	while (end > s && (*end == ' ' || *end == '\t' || *end == '\n' || *end == '\r'))
+		*end-- = '\0';
+	return s;
+}
+
+static int config_parse(const char *path, struct config *c)
+{
+	FILE *f = fopen(path, "r");
+	if (!f) {
+		perror(path);
+		return -1;
+	}
+
+	char line[512];
+	while (fgets(line, sizeof(line), f)) {
+		char *p = trim(line);
+		if (*p == '#' || *p == '\0')
+			continue;
+
+		char *eq = strchr(p, '=');
+		if (!eq) continue;
+
+		*eq = '\0';
+		char *key = trim(p);
+		char *val = trim(eq + 1);
+
+		if (!strcmp(key, "broker_host"))   { strncpy(c->broker_host, val, sizeof(c->broker_host) - 1); }
+		else if (!strcmp(key, "broker_port"))   { c->broker_port = atoi(val); }
+		else if (!strcmp(key, "broker_user"))   { strncpy(c->broker_user, val, sizeof(c->broker_user) - 1); }
+		else if (!strcmp(key, "broker_pass"))   { strncpy(c->broker_pass, val, sizeof(c->broker_pass) - 1); }
+		else if (!strcmp(key, "device_id"))     { strncpy(c->device_id, val, sizeof(c->device_id) - 1); }
+		else if (!strcmp(key, "uart_device"))   { strncpy(c->uart_device, val, sizeof(c->uart_device) - 1); }
+		else if (!strcmp(key, "ir_led_gpio"))   { c->ir_led_gpio = atoi(val); }
+		else if (!strcmp(key, "ir_cut_gpio"))   { c->ir_cut_gpio = atoi(val); }
+		else if (!strcmp(key, "main_led_gpio")) { c->main_led_gpio = atoi(val); }
+		else if (!strcmp(key, "stream_url"))    { strncpy(c->stream_url, val, sizeof(c->stream_url) - 1); }
+		else if (!strcmp(key, "snapshot_url"))  { strncpy(c->snapshot_url, val, sizeof(c->snapshot_url) - 1); }
+		else if (!strcmp(key, "audio_url"))     { strncpy(c->audio_url, val, sizeof(c->audio_url) - 1); }
+		else if (!strcmp(key, "play_audio_url")){ strncpy(c->play_audio_url, val, sizeof(c->play_audio_url) - 1); }
+		else if (!strcmp(key, "state_file"))    { strncpy(c->state_file, val, sizeof(c->state_file) - 1); }
+		else if (!strcmp(key, "timezone"))      { strncpy(c->timezone, val, sizeof(c->timezone) - 1); }
+		else { log_err("catd: unknown config key: %s\n", key); }
+	}
+
+	fclose(f);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Network helpers                                                     */
+/* ------------------------------------------------------------------ */
+
+static int get_device_ip(char *buf, size_t len)
+{
+	struct ifaddrs *iflist, *ifa;
+	if (getifaddrs(&iflist) < 0)
+		return -1;
+
+	int found = -1;
+	for (ifa = iflist; ifa; ifa = ifa->ifa_next) {
+		if (!ifa->ifa_addr || ifa->ifa_addr->sa_family != AF_INET)
+			continue;
+		if (ifa->ifa_flags & IFF_LOOPBACK)
+			continue;
+		if (!(ifa->ifa_flags & IFF_UP))
+			continue;
+
+		struct sockaddr_in *sa = (struct sockaddr_in *)ifa->ifa_addr;
+		inet_ntop(AF_INET, &sa->sin_addr, buf, (socklen_t)len);
+		found = 0;
+		break;
+	}
+
+	freeifaddrs(iflist);
+	return found;
+}
+
+static void resolve_media_urls(struct config *c)
+{
+	if (c->stream_url[0] && c->snapshot_url[0] &&
+	    c->audio_url[0] && c->play_audio_url[0])
+		return;
+
+	char ip[64];
+	if (get_device_ip(ip, sizeof(ip)) < 0) {
+		log_err("catd: could not detect device IP for media URLs\n");
+		return;
+	}
+
+	log_info("catd: detected device IP: %s\n", ip);
+
+	if (!c->stream_url[0])
+		snprintf(c->stream_url, sizeof(c->stream_url),
+			 "rtsp://%s:554/stream=0", ip);
+	if (!c->snapshot_url[0])
+		snprintf(c->snapshot_url, sizeof(c->snapshot_url),
+			 "http://%s/image.jpg", ip);
+	if (!c->audio_url[0])
+		snprintf(c->audio_url, sizeof(c->audio_url),
+			 "http://%s/audio.m4a", ip);
+	if (!c->play_audio_url[0])
+		snprintf(c->play_audio_url, sizeof(c->play_audio_url),
+			 "http://%s/play_audio", ip);
+}
+
+/* ------------------------------------------------------------------ */
+/* ISP brightness                                                      */
+/* ------------------------------------------------------------------ */
+
+static void fetch_isp_again(char *buf, size_t len)
+{
+	buf[0] = '\0';
+	int fd = socket(AF_INET, SOCK_STREAM, 0);
+	if (fd < 0) return;
+
+	struct sockaddr_in sa;
+	memset(&sa, 0, sizeof(sa));
+	sa.sin_family = AF_INET;
+	sa.sin_port = htons(80);
+	sa.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+
+	if (connect(fd, (struct sockaddr *)&sa, sizeof(sa)) < 0) {
+		close(fd);
+		return;
+	}
+
+	const char *req = "GET /metrics/isp?value=isp_again HTTP/1.0\r\n"
+			  "Host: localhost\r\n\r\n";
+	write(fd, req, strlen(req));
+
+	char resp[512];
+	int total = 0;
+	ssize_t n;
+	while (total < (int)sizeof(resp) - 1 &&
+	       (n = read(fd, resp + total, sizeof(resp) - 1 - total)) > 0)
+		total += (int)n;
+	resp[total] = '\0';
+	close(fd);
+
+	char *body = strstr(resp, "\r\n\r\n");
+	if (!body) return;
+	body += 4;
+
+	while (*body == ' ' || *body == '\n' || *body == '\r') body++;
+	char *end = body;
+	while (*end && *end != '\n' && *end != '\r') end++;
+	*end = '\0';
+
+	if (*body)
+		snprintf(buf, len, "%s", body);
+}
+
+static void poll_brightness(void)
+{
+	time_t now = time(NULL);
+	if (now - g_last_brightness < 60)
+		return;
+	g_last_brightness = now;
+
+	char val[32];
+	fetch_isp_again(val, sizeof(val));
+	if (val[0])
+		mqtt_publish(TOPIC_PREFIX "brightness", val, 1);
+}
+
+static int majestic_connect(void)
+{
+	int fd = socket(AF_INET, SOCK_STREAM, 0);
+	if (fd < 0) return -1;
+
+	struct sockaddr_in sa;
+	memset(&sa, 0, sizeof(sa));
+	sa.sin_family = AF_INET;
+	sa.sin_port = htons(80);
+	sa.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+
+	if (connect(fd, (struct sockaddr *)&sa, sizeof(sa)) < 0) {
+		close(fd);
+		return -1;
+	}
+	return fd;
+}
+
+static int fetch_light_monitor(void)
+{
+	int fd = majestic_connect();
+	if (fd < 0) return -1;
+
+	const char *req = "GET /api/v1/config.json HTTP/1.0\r\n"
+			  "Host: localhost\r\n\r\n";
+	write(fd, req, strlen(req));
+
+	char *buf = malloc(32768);
+	if (!buf) { close(fd); return -1; }
+
+	int total = 0;
+	ssize_t n;
+	while (total < 32767 &&
+	       (n = read(fd, buf + total, 32767 - total)) > 0)
+		total += (int)n;
+	buf[total] = '\0';
+	close(fd);
+
+	int result = -1;
+	char *p = strstr(buf, "\"lightMonitor\"");
+	if (p) {
+		p = strchr(p, ':');
+		if (p) {
+			p++;
+			while (*p == ' ' || *p == '\t') p++;
+			if (!strncmp(p, "true", 4))       result = 1;
+			else if (!strncmp(p, "false", 5)) result = 0;
+		}
+	}
+	free(buf);
+	return result;
+}
+
+static int set_light_monitor(int enabled)
+{
+	int fd = majestic_connect();
+	if (fd < 0) return -1;
+
+	char req[256];
+	snprintf(req, sizeof(req),
+		 "GET /api/v1/set?nightMode.lightMonitor=%s HTTP/1.0\r\n"
+		 "Host: localhost\r\n\r\n",
+		 enabled ? "true" : "false");
+	write(fd, req, strlen(req));
+
+	char drain[256];
+	while (read(fd, drain, sizeof(drain)) > 0) {}
+	close(fd);
+	return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Persisted state (key=value file in the overlay)                     */
+/* ------------------------------------------------------------------ */
+/*
+ * We persist anything the user explicitly configured via HA so that on
+ * reboot we can restore both the SoC-side controls (feed amount, GPIO
+ * states) and re-push the saved schedule to the MCU. Format is the same
+ * key=value text used by the main config — easy to parse and to inspect
+ * with `cat`. Writes are atomic (write to .tmp + fsync + rename) so a
+ * crash mid-write can't truncate the file.
+ */
+
+static void state_save(void)
+{
+	if (!cfg.state_file[0]) return;
+
+	char tmp[160];
+	snprintf(tmp, sizeof(tmp), "%s.tmp", cfg.state_file);
+
+	FILE *f = fopen(tmp, "w");
+	if (!f) {
+		log_err("catd: state_save: open %s: %s\n", tmp, strerror(errno));
+		return;
+	}
+
+	fprintf(f, "# catd persisted state — overwritten on every change\n");
+	fprintf(f, "feed_amount=%d\n", g_feed_amount);
+	fprintf(f, "ir_led=%d\n", g_ir_led_state);
+	fprintf(f, "ir_cut=%d\n", g_ir_cut_state);
+	if (cfg.main_led_gpio >= 0)
+		fprintf(f, "main_led=%d\n", g_main_led_state);
+	fprintf(f, "light_monitor=%d\n", g_light_monitor_state);
+
+	for (int i = 1; i <= NUM_MEAL_SLOTS; i++) {
+		const struct mcu_slot *s = &g_schedule[i];
+		fprintf(f, "slot%d_hour=%d\n",    i, s->hour);
+		fprintf(f, "slot%d_minute=%d\n",  i, s->minute);
+		fprintf(f, "slot%d_weight=%d\n",  i, s->weight);
+		fprintf(f, "slot%d_enabled=%d\n", i, s->enabled);
+		fprintf(f, "slot%d_audio=%d\n",   i, s->audio_idx);
+	}
+
+	fflush(f);
+	fsync(fileno(f));
+	fclose(f);
+
+	if (rename(tmp, cfg.state_file) < 0) {
+		log_err("catd: state_save: rename %s -> %s: %s\n",
+			tmp, cfg.state_file, strerror(errno));
+		unlink(tmp);
+	}
+}
+
+/*
+ * Load saved state into the same globals state_save() wrote. Missing file
+ * is not an error — defaults stay in place. Returns 1 if a file was read,
+ * 0 otherwise.
+ */
+static int state_load(void)
+{
+	if (!cfg.state_file[0]) return 0;
+
+	FILE *f = fopen(cfg.state_file, "r");
+	if (!f) {
+		log_info("catd: no saved state at %s (using defaults)\n",
+			 cfg.state_file);
+		return 0;
+	}
+
+	char line[256];
+	while (fgets(line, sizeof(line), f)) {
+		char *p = trim(line);
+		if (*p == '#' || *p == '\0') continue;
+		char *eq = strchr(p, '=');
+		if (!eq) continue;
+		*eq = '\0';
+		char *key = trim(p);
+		char *val = trim(eq + 1);
+		int v = atoi(val);
+
+		if      (!strcmp(key, "feed_amount"))   g_feed_amount = v;
+		else if (!strcmp(key, "ir_led"))        g_ir_led_state = v;
+		else if (!strcmp(key, "ir_cut"))        g_ir_cut_state = v;
+		else if (!strcmp(key, "main_led"))      g_main_led_state = v;
+		else if (!strcmp(key, "light_monitor")) g_light_monitor_state = v;
+		else if (!strncmp(key, "slot", 4)) {
+			int slot = atoi(key + 4);
+			char *under = strchr(key + 4, '_');
+			if (slot < 1 || slot > NUM_MEAL_SLOTS || !under)
+				continue;
+			const char *field = under + 1;
+			struct mcu_slot *s = &g_schedule[slot];
+			s->slot_num = slot;
+			if (s->kind == MCU_SLOT_EMPTY) s->kind = MCU_SLOT_AUTOFEED;
+			if      (!strcmp(field, "hour"))    s->hour = v;
+			else if (!strcmp(field, "minute"))  s->minute = v;
+			else if (!strcmp(field, "weight"))  s->weight = v;
+			else if (!strcmp(field, "enabled")) s->enabled = v;
+			else if (!strcmp(field, "audio"))   s->audio_idx = v;
+		}
+	}
+
+	fclose(f);
+	log_info("catd: loaded state from %s (feed_amount=%d)\n",
+		 cfg.state_file, g_feed_amount);
+	return 1;
+}
