+static const char *ha_device_fmt =
+	"\"dev\":{"
+		"\"ids\":[\"%s\"],"
+		"\"name\":\"Cat Feeder\","
+		"\"mf\":\"Dogness\","
+		"\"mdl\":\"PETS V200\","
+		"\"sw\":\"catd 1.1\""
+	"},"
+	"\"avty_t\":\"homeassistant/cat/status\","
+	"\"pl_avail\":\"online\","
+	"\"pl_not_avail\":\"offline\"";
+
+static void publish_schedule_discovery(int slot, const char *dev)
+{
+	char buf[1024];
+	char obj[32];
+
+	if (slot < 1 || slot > NUM_MEAL_SLOTS) return;
+
+	/* Time entity — exposed as a `text` MQTT entity so it appears reliably
+	 * across HA versions / discovery quirks. The `pattern` enforces HH:MM
+	 * input client-side; catd's parse_hhmm accepts HH:MM and HH:MM:SS. */
+	snprintf(obj, sizeof(obj), "schedule_%d_time", slot);
+	snprintf(buf, sizeof(buf),
+		 "{"
+		 "\"name\":\"Schedule %d Time\","
+		 "\"uniq_id\":\"%s_sched%d_time\","
+		 "\"cmd_t\":\"homeassistant/cat/schedule/%d/time/set\","
+		 "\"stat_t\":\"homeassistant/cat/schedule/%d/time\","
+		 "\"pattern\":\"^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$\","
+		 "\"min\":5,\"max\":8,"
+		 "\"ic\":\"mdi:clock-outline\","
+		 "%s"
+		 "}",
+		 slot, cfg.device_id, slot, slot, slot, dev);
+	ha_publish("text", obj, buf);
+
+	/* Weight number entity — exposed as portions (1..10); catd multiplies
+	 * by 10 before sending to the MCU so the wire bytes are in the MCU's
+	 * native unit (which the MCU validates as ≥ 10). */
+	snprintf(obj, sizeof(obj), "schedule_%d_weight", slot);
+	snprintf(buf, sizeof(buf),
+		 "{"
+		 "\"name\":\"Schedule %d Portions\","
+		 "\"uniq_id\":\"%s_sched%d_weight\","
+		 "\"cmd_t\":\"homeassistant/cat/schedule/%d/weight/set\","
+		 "\"stat_t\":\"homeassistant/cat/schedule/%d/weight\","
+		 "\"min\":1,\"max\":10,\"step\":1,"
+		 "\"unit_of_meas\":\"portions\","
+		 "\"mode\":\"slider\","
+		 "\"ic\":\"mdi:scale\","
+		 "%s"
+		 "}",
+		 slot, cfg.device_id, slot, slot, slot, dev);
+	ha_publish("number", obj, buf);
+
+	/* Enabled switch */
+	snprintf(obj, sizeof(obj), "schedule_%d_enabled", slot);
+	snprintf(buf, sizeof(buf),
+		 "{"
+		 "\"name\":\"Schedule %d Enabled\","
+		 "\"uniq_id\":\"%s_sched%d_enabled\","
+		 "\"cmd_t\":\"homeassistant/cat/schedule/%d/enabled/set\","
+		 "\"stat_t\":\"homeassistant/cat/schedule/%d/enabled\","
+		 "\"pl_on\":\"ON\",\"pl_off\":\"OFF\","
+		 "\"ic\":\"mdi:calendar-check\","
+		 "%s"
+		 "}",
+		 slot, cfg.device_id, slot, slot, slot, dev);
+	ha_publish("switch", obj, buf);
+}
