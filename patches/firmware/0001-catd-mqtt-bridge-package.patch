+/* ------------------------------------------------------------------ */
+/* Home Assistant MQTT Discovery                                       */
+/* ------------------------------------------------------------------ */
+
+static void ha_publish(const char *component, const char *object_id,
+		       const char *payload)
+{
+	char topic[256];
+	snprintf(topic, sizeof(topic), "homeassistant/%s/%s/%s/config",
+		 component, cfg.device_id, object_id);
+	mqtt_publish(topic, payload, 1);
+}
