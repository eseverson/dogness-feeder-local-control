+/* ------------------------------------------------------------------ */
+/* MQTT helpers                                                        */
+/* ------------------------------------------------------------------ */
+
+static void mqtt_publish(const char *topic, const char *payload, int retain)
+{
+	if (!g_mosq) return;
+	mosquitto_publish(g_mosq, NULL, topic, (int)strlen(payload),
+			  payload, 1, retain);
+}
+
+static void publish_feed_status(const char *status)
+{
+	mqtt_publish(TOPIC_PREFIX "feed/status", status, 1);
+}
+
+static void publish_feed_result(const struct mcu_feed_result *r,
+				const uint8_t *raw, int raw_len)
+{
+	char hexbuf[192] = "";
+	int hpos = 0;
+	for (int i = 0; i < raw_len && hpos < (int)sizeof(hexbuf) - 3; i++)
+		hpos += snprintf(hexbuf + hpos, sizeof(hexbuf) - hpos,
+				 "%02x ", raw[i]);
+
+	char json[512];
+	snprintf(json, sizeof(json),
+		 "{\"portions\":%d,\"weight\":%d,\"food_confirmed\":%s,"
+		 "\"feed_type\":%d,\"audio\":%d,\"raw\":\"%s\"}",
+		 r->portions, r->weight,
+		 r->food_confirmed ? "true" : "false",
+		 r->feed_type, r->audio_index, hexbuf);
+	/* retain=1: HA restores the last result after a restart / MQTT
+	 * reconnect / discovery re-announce. With retain=0 the Feed Result
+	 * sensor reverts to "unknown" between feeds. */
+	mqtt_publish(TOPIC_PREFIX "feed/result", json, 1);
+}
+
+static void publish_mcu_version(void)
+{
+	if (g_mcu_have_version)
+		mqtt_publish(TOPIC_PREFIX "mcu/version", g_mcu_version, 1);
+}
+
+/*
+ * The MCU stores wall-clock time without a timezone tag; we set it from
+ * localtime() so MCU "12:00" means the device's local 12:00. Convert that
+ * back to a UTC unix time and emit ISO 8601 with a Z suffix — HA's
+ * device_class:timestamp requires the timezone marker (without it the
+ * sensor stays "unknown").
+ */
+static void publish_mcu_time(time_t mcu_unix, int drift_sec)
+{
+	struct tm utc;
+	gmtime_r(&mcu_unix, &utc);
+
+	char iso[40];
+	strftime(iso, sizeof(iso), "%Y-%m-%dT%H:%M:%SZ", &utc);
+	mqtt_publish(TOPIC_PREFIX "mcu/time", iso, 1);
+
+	char drift[16];
+	snprintf(drift, sizeof(drift), "%d", drift_sec);
+	mqtt_publish(TOPIC_PREFIX "mcu/drift_sec", drift, 1);
+}
+
+static const char *slot_kind_str(enum mcu_slot_kind k)
+{
+	switch (k) {
+	case MCU_SLOT_AUTOFEED: return "autofeed";
+	case MCU_SLOT_MEAL:     return "meal";
+	default:                return "empty";
+	}
+}
+
+static void publish_schedule_slot(int slot)
+{
+	if (slot < 1 || slot > NUM_MEAL_SLOTS) return;
+	const struct mcu_slot *s = &g_schedule[slot];
+
+	char base[64];
+	snprintf(base, sizeof(base), TOPIC_PREFIX "schedule/%d", slot);
+
+	char topic[96];
+	char val[32];
+
+	/* HH:MM string for HA time entity */
+	snprintf(topic, sizeof(topic), "%s/time", base);
+	snprintf(val, sizeof(val), "%02d:%02d:00", s->hour, s->minute);
+	mqtt_publish(topic, val, 1);
+
+	/* Weight (grams) for HA number entity */
+	snprintf(topic, sizeof(topic), "%s/weight", base);
+	snprintf(val, sizeof(val), "%d", s->weight);
+	mqtt_publish(topic, val, 1);
+
+	/* Enabled state for HA switch */
+	snprintf(topic, sizeof(topic), "%s/enabled", base);
+	mqtt_publish(topic, s->enabled ? "ON" : "OFF", 1);
+
+	/* Slot kind (autofeed / meal / empty) for diagnostic */
+	snprintf(topic, sizeof(topic), "%s/kind", base);
+	mqtt_publish(topic, slot_kind_str(s->kind), 1);
+}
