diff --git a/general/package/all-patches/linux/0022-add-by25q256fs-spi-nor-id.patch b/general/package/all-patches/linux/0022-add-by25q256fs-spi-nor-id.patch
new file mode 100644
index 00000000..1efb3840
--- /dev/null
+++ b/general/package/all-patches/linux/0022-add-by25q256fs-spi-nor-id.patch
@@ -0,0 +1,25 @@
+Add Boya BY25Q256FS to the SPI NOR ID table.
+
+JEDEC ID 0x68/0x49/0x19. The chip is a 256Mb (32MB) W25Q256-class part
+that supports native 4-byte addressing opcodes (READ4 0x13, PP4 0x12,
+SE4 0x21, BE4 0xDC), so SPI_NOR_4B_OPCODES is set.
+
+Required for cameras shipped with (or upgraded to) BY25Q256FSSIG NOR.
+Without this entry hisi-sfc fails to register the device and Linux
+panics with "VFS: Cannot open root device" since mtdblockN never appear.
+
+--- a/drivers/mtd/spi-nor/spi-nor.c
++++ b/drivers/mtd/spi-nor/spi-nor.c
+@@ -1374,7 +1374,12 @@ static const struct flash_info spi_nor_ids[] = {
+ 	{ "w25q256jw", INFO(0xef8019, 0, 64 * 1024, 512,
+ 			SECT_4K | SPI_NOR_DUAL_READ | SPI_NOR_QUAD_READ |
+ 			SPI_NOR_HAS_LOCK | SPI_NOR_HAS_TB | SPI_NOR_4B_OPCODES),
+ 			PARAMS(winbond) },
++
++	/* Boya BY25Q256FS, JEDEC 0x68 0x49 0x19, W25Q256-class, native 4-byte opcodes */
++	{ "by25q256fs", INFO(0x684919, 0, 64 * 1024, 512,
++			SECT_4K | SPI_NOR_DUAL_READ | SPI_NOR_QUAD_READ |
++			SPI_NOR_4B_OPCODES) },
+ 
+ 	/* Catalyst / On Semiconductor -- non-JEDEC */
+ 	{ "cat25c11", CAT25_INFO(16, 8, 16, 1, SPI_NOR_NO_ERASE
diff --git a/general/package/all-patches/linux/0023-spi-nor-keep-4b-opcode-flash-in-3-byte-mode.patch b/general/package/all-patches/linux/0023-spi-nor-keep-4b-opcode-flash-in-3-byte-mode.patch
new file mode 100644
index 00000000..271ef895
--- /dev/null
+++ b/general/package/all-patches/linux/0023-spi-nor-keep-4b-opcode-flash-in-3-byte-mode.patch
@@ -0,0 +1,30 @@
+spi-nor: keep 4-byte-opcode flash in 3-byte address mode
+
+A BY25Q256 left in 4-byte mode by U-Boot survives every warm reset, and the
+hi3518ev200 BootROM then cannot read U-Boot back. Exit it at probe.
+
+--- a/drivers/mtd/spi-nor/spi-nor.c	2026-11-04 16:08:41.449213753 -0800
++++ b/drivers/mtd/spi-nor/spi-nor.c	2026-11-04 16:08:57.893101142 -0800
+@@ -2356,9 +2356,20 @@
+ 		/* enable 4-byte addressing if the device exceeds 16MiB */
+ 		nor->addr_width = 4;
+ 		if (JEDEC_MFR(info) == SNOR_MFR_SPANSION ||
+-		    info->flags & SPI_NOR_4B_OPCODES)
++		    info->flags & SPI_NOR_4B_OPCODES) {
+ 			spi_nor_set_4byte_opcodes(nor, info);
+-		else
++			/*
++			 * The 4-byte opcodes carry their own address width, so the
++			 * chip can stay in 3-byte mode -- and must: the bootloader
++			 * may hand it over in 4-byte mode (hifmc100 U-Boot does),
++			 * no reset resets the flash, and a BootROM reading it with
++			 * 3-byte addresses after reboot, panic or watchdog never
++			 * finds U-Boot again. set_4byte() would send these chips the
++			 * Spansion BRWR, so issue EX4B directly.
++			 */
++			if (JEDEC_MFR(info) != SNOR_MFR_SPANSION)
++				nor->write_reg(nor, SPINOR_OP_EX4B, NULL, 0);
++		} else
+ 			set_4byte(nor, info, 1);
+ 	} else {
+ 		nor->addr_width = 3;
