diff --git a/br-ext-chip-hisilicon/configs/hi3518ev200_recovery_defconfig b/br-ext-chip-hisilicon/configs/hi3518ev200_recovery_defconfig
new file mode 100644
index 00000000..30d4b675
--- /dev/null
+++ b/br-ext-chip-hisilicon/configs/hi3518ev200_recovery_defconfig
@@ -0,0 +1,75 @@
+# Recovery / failsafe rootfs for hi3518ev200 (32MB NOR).
+#
+# Goals:
+#   - Bake into the kernel uImage as initramfs (single 8MB blob).
+#   - Bring up wifi (RTL8188FU on this board) and dropbear so a deploy
+#     script can SSH in and re-flash main partitions via flashcp.
+#   - Strip everything not needed for that: no majestic, no MQTT, no
+#     wireguard, no streaming.
+#
+# Built via: make BOARD=hi3518ev200_recovery TARGET=...
+# Output:    output-*/images/uImage.hi3518ev200 (kernel + embedded initramfs)
+
+# Architecture
+BR2_arm=y
+
+# Toolchain
+BR2_TOOLCHAIN_EXTERNAL=y
+BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
+BR2_TOOLCHAIN_EXTERNAL_DOWNLOAD=y
+BR2_TOOLCHAIN_EXTERNAL_URL="https://github.com/openipc/firmware/releases/download/$(OPENIPC_TOOLCHAIN).tgz"
+BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-openipc-linux-musleabi"
+BR2_TOOLCHAIN_EXTERNAL_HEADERS_4_9=y
+BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
+BR2_TOOLCHAIN_EXTERNAL_CXX=y
+
+# Kernel — same generic config as main, so the wifi driver ABI matches.
+BR2_LINUX_KERNEL=y
+BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
+BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="https://github.com/openipc/linux/archive/$(OPENIPC_KERNEL).tar.gz"
+BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
+BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(EXTERNAL_VENDOR)/board/$(OPENIPC_SOC_FAMILY)/hi3518ev200.generic.config"
+BR2_LINUX_KERNEL_UIMAGE=y
+BR2_LINUX_KERNEL_XZ=y
+
+# Filesystem — INITRAMFS only (baked into the kernel image).
+BR2_PACKAGE_BUSYBOX_CONFIG="$(BR2_EXTERNAL)/package/busybox/busybox.config"
+BR2_PACKAGE_UBOOT_TOOLS=y
+BR2_PACKAGE_WIRELESS_TOOLS=y
+BR2_PACKAGE_WPA_SUPPLICANT=y
+BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
+BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
+BR2_TARGET_ROOTFS_INITRAMFS=y
+# (squashfs/ubi/cpio intentionally not set — we only want the initramfs uImage)
+
+# OpenIPC variant identity
+BR2_OPENIPC_SOC_VENDOR="hisilicon"
+BR2_OPENIPC_SOC_MODEL="hi3518ev200"
+BR2_OPENIPC_SOC_FAMILY="hi3516cv200"
+BR2_OPENIPC_VARIANT="recovery"
+BR2_OPENIPC_FLASH_SIZE="32"
+
+# Override the fragment's hostname so mDNS/avahi distinguishes recovery
+# from main on the same network.
+BR2_TARGET_GENERIC_HOSTNAME="openipc-$(OPENIPC_SOC_MODEL)-recovery"
+
+# Layer the recovery-specific overlay on top of the shared main overlay.
+# Later paths win on file conflicts, so recovery-overlay is the override layer.
+BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL)/overlay $(BR2_EXTERNAL)/recovery-overlay"
+
+# Packages — bare minimum for "boot, wifi, sshd, flashcp"
+BR2_PACKAGE_DROPBEAR_OPENIPC=y
+BR2_PACKAGE_HISILICON_OSDRV_HI3516CV200=y
+BR2_PACKAGE_LIBCURL_OPENIPC=y
+BR2_PACKAGE_LIBCURL_OPENIPC_CURL=y
+# BR2_PACKAGE_LIBCURL_OPENIPC_PROXY_SUPPORT is not set
+# BR2_PACKAGE_LIBCURL_OPENIPC_COOKIES_SUPPORT is not set
+# BR2_PACKAGE_LIBCURL_OPENIPC_EXTRA_PROTOCOLS_FEATURES is not set
+BR2_PACKAGE_LINUX_FIRMWARE_OPENIPC=y
+BR2_PACKAGE_LINUX_FIRMWARE_OPENIPC_RTL_8188EU=y
+BR2_PACKAGE_RTL8188FU_OPENIPC=y
+
+# Timezone (small, useful for logs)
+BR2_TARGET_TZ_INFO=y
+BR2_TARGET_TZ_ZONELIST="northamerica"
+BR2_TARGET_LOCALTIME="America/Los_Angeles"
