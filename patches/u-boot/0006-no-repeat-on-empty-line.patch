Disable command repeat on empty input line.

U-Boot 2010.06 default behavior: pressing Enter on an empty prompt
re-runs the last command (CMD_FLAG_REPEAT). That makes it easy to
run "sf erase" or "reset" again by accident. Remove the repeat
setup so empty lines just redraw the prompt.

--- a/common/main.c
+++ b/common/main.c
@@ -476,8 +476,6 @@ void main_loop (void)
 		flag = 0;	/* assume no special flags for now */
 		if (len > 0)
 			strcpy (lastcommand, console_buffer);
-		else if (len == 0)
-			flag |= CMD_FLAG_REPEAT;
 #ifdef CONFIG_BOOT_RETRY_TIME
 		else if (len == -2) {
 			/* -2 means timed out, retry autoboot
@@ -494,7 +492,7 @@ void main_loop (void)
 
 		if (len == -1)
 			puts ("<INTERRUPT>\n");
-		else
+		else if (len > 0)
 #ifdef CONFIG_BOOT_RETRY_TIME
 			rc = run_command(lastcommand, flag);
 #else
